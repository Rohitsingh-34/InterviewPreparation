    {
      "id": "hFnYOGjbW2QJMj9o3HG4g",
      "type": "text",
      "x": -6345.332419913644,
      "y": 1044.5834740251462,
      "width": 650,
      "height": 290,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6I",
      "roundness": null,
      "seed": 835117923,
      "version": 35,
      "versionNonce": 1606376195,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "WORKED EXAMPLE\n=====================================\nInput: PREMIUM customer BUYS $200,000 of STOCK\n\nSTOCK_BASE_FEE\n   scope STOCK OK | no conditions OK   -> MATCH\n   0.10% x 200,000                     ->  $200\n\nHIGH_VALUE_STOCK_FEE\n   scope STOCK OK | amount > 100k OK   -> MATCH\n   0.08% x 200,000                     ->  $160\n\nBOND_BASE_FEE\n   scope BOND -> instrument is STOCK   -> SKIP\n\nREGULATORY_FEE\n   scope ALL OK | no conditions OK     -> MATCH\n   fixed                               ->    $2\n                                          --------\n   FeeResult total                        $362",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WORKED EXAMPLE\n=====================================\nInput: PREMIUM customer BUYS $200,000 of STOCK\n\nSTOCK_BASE_FEE\n   scope STOCK OK | no conditions OK   -> MATCH\n   0.10% x 200,000                     ->  $200\n\nHIGH_VALUE_STOCK_FEE\n   scope STOCK OK | amount > 100k OK   -> MATCH\n   0.08% x 200,000                     ->  $160\n\nBOND_BASE_FEE\n   scope BOND -> instrument is STOCK   -> SKIP\n\nREGULATORY_FEE\n   scope ALL OK | no conditions OK     -> MATCH\n   fixed                               ->    $2\n                                          --------\n   FeeResult total                        $362",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "oIv9wqkh-sxxi_LNqcbXI",
      "type": "rectangle",
      "x": -5620.332419913644,
      "y": 1019.5834740251462,
      "width": 580,
      "height": 340,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6J",
