      "link": null,
      "locked": false,
      "text": "class JobScheduler{\n   Priority_queue<Job> scheduleQueue; // min-heap on scheduleTime\n   Priority_queue<Job> readyQueue  // min heap on priority (use comparator that)\n   mutex schedulemt\n   mutex readymt\n   condition_variable schedulecv\n   condition_variable readycv\n\n    void schedulingloop(){\n        while(running){\n\n            schedulemt.lock();\n            \n            schedulecv.wait(lock, !scheduleQueue.empty())\n\n            if(!scheduleQueue.empty()){\n                \n                nextjob = schedulequeue.top()\n\n                if(nextjob.scheduleAt <= now){\n\n                    nextjob.status = 'QUEUED'\n                    readyqueue.push(job)\n                    schedulequeue.pop()\n                }\n\n                readycv.notify()    \n            }\n            \n            \n        }\n    }\n\n    Job acquireJob(){\n         readymt.lock()\n         \n        readycv.wait(lock,!readyqueue.empty())  // release lock and wait untill queue is \n                                           // non-empty and thread went to sleep\n        \n         if(readyqueue.empty())\n             return NULL\n        \n        job = readyqueue.top()\n            readyqueue.pop()\n\n        if(job.status == 'CANCELED')\n            RETURN null\n\n        job.status = 'RUNNING'\n        jobrepo.updatedstatus(job)\n\n        return job\n             \n     }\n\npublic: \n\n     jobid submitJob(Job job){\n          readymt.lock()\n\n          jobrepo.savejob(job)\n        \n         if(Job.scheduledTime <= now)\n            job.status = 'QUEUED'\n            readyqueue.push(Job)\n            readycv.notify()\n         \n         readymt.unlock()\n         schedulemt.lock();\n\n         if(job.schedule > now)\n            job.status = 'SCHEDULED'\n            scheduledQueue.push(Job)\n            schedulecv.notify()\n     }\n\n     bool canceljob(Job job){\n        \n     }\n\n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class JobScheduler{\n   Priority_queue<Job> scheduleQueue; // min-heap on scheduleTime\n   Priority_queue<Job> readyQueue  // min heap on priority (use comparator that)\n   mutex schedulemt\n   mutex readymt\n   condition_variable schedulecv\n   condition_variable readycv\n\n    void schedulingloop(){\n        while(running){\n\n            schedulemt.lock();\n            \n            schedulecv.wait(lock, !scheduleQueue.empty())\n\n            if(!scheduleQueue.empty()){\n                \n                nextjob = schedulequeue.top()\n\n                if(nextjob.scheduleAt <= now){\n\n                    nextjob.status = 'QUEUED'\n                    readyqueue.push(job)\n                    schedulequeue.pop()\n                }\n\n                readycv.notify()    \n            }\n            \n            \n        }\n    }\n\n    Job acquireJob(){\n         readymt.lock()\n         \n        readycv.wait(lock,!readyqueue.empty())  // release lock and wait untill queue is \n                                           // non-empty and thread went to sleep\n        \n         if(readyqueue.empty())\n             return NULL\n        \n        job = readyqueue.top()\n            readyqueue.pop()\n\n        if(job.status == 'CANCELED')\n            RETURN null\n\n        job.status = 'RUNNING'\n        jobrepo.updatedstatus(job)\n\n        return job\n             \n     }\n\npublic: \n\n     jobid submitJob(Job job){\n          readymt.lock()\n\n          jobrepo.savejob(job)\n        \n         if(Job.scheduledTime <= now)\n            job.status = 'QUEUED'\n            readyqueue.push(Job)\n            readycv.notify()\n         \n         readymt.unlock()\n         schedulemt.lock();\n\n         if(job.schedule > now)\n            job.status = 'SCHEDULED'\n            scheduledQueue.push(Job)\n            schedulecv.notify()\n     }\n\n     bool canceljob(Job job){\n        \n     }\n\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "QoPQsREVvDChqy_Omnl7K",
      "type": "text",
      "x": 58936.04393323033,
      "y": -3747.1804789924654,
      "width": 1416.7996826171875,
      "height": 5915,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
