      "baseFontSize": null
    },
    {
      "id": "po8ZJZ2LgpTbL-D7e2-LX",
      "type": "text",
      "x": 28650.88015230768,
      "y": 11196.778288226196,
      "width": 1605.46875,
      "height": 192,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1534355542,
      "version": 136,
      "versionNonce": 1779718102,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788642736654,
      "link": null,
      "locked": false,
      "text": "Provider (e.g., Twilio) has a hard limit, say 1,000 SMS/sec.\nBulk traffic can consume all capacity and starve critical notifications.\nUse a shared Redis Token Bucket before calling the provider.\nReserve a fixed portion for critical traffic, e.g. 200/sec critical + 800/sec bulk.\nIf critical doesn't use its reserved capacity, release unused tokens to bulk.\nFlow: Kafka → Worker → Preference Check → Redis Token Bucket → Provider → User.\nPreference check should be a cache hit for low latency.\nKeep internal processing <1 sec so critical notifications have most of the 5-sec SLO available for provider/carrier delivery and retries.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 187,
      "containerId": null,
      "originalText": "Provider (e.g., Twilio) has a hard limit, say 1,000 SMS/sec.\nBulk traffic can consume all capacity and starve critical notifications.\nUse a shared Redis Token Bucket before calling the provider.\nReserve a fixed portion for critical traffic, e.g. 200/sec critical + 800/sec bulk.\nIf critical doesn't use its reserved capacity, release unused tokens to bulk.\nFlow: Kafka → Worker → Preference Check → Redis Token Bucket → Provider → User.\nPreference check should be a cache hit for low latency.\nKeep internal processing <1 sec so critical notifications have most of the 5-sec SLO available for provider/carrier delivery and retries.",
      "lineHeight": 1.2,
      "index": "bFP",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "RJpgAShLxdIcvmJORlv6K",
      "type": "text",
      "x": 26614.330505836864,
      "y": 10557.816095985165,
      "width": 832.03125,
      "height": 120,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
