      "originalText": "RuleJson{\n    instrument: enum\n    condition:{\n        field : \"amount\"\n        operator : \"GREATER_THAN\"\n        value : 10000\n    }\n    rate:{\n        type : \"percentage\"\n        value : 0.08\n    }\n\n}\n\n\n\n\n\nClass RuleExecutur{\n\n    bool IsApplicable(Condition condition){\n        //check and return \n    }\n    \n    float applyRule(float Amount, Rule rule){\n            // apply rule and return fee\n    }\n\n}",
