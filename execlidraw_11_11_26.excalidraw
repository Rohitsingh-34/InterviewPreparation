      "updated": 1787005668182,
      "link": null,
      "locked": false,
      "text": "ENUM NotificationType{\n    SMS,\n    EMAIL,\n    PUSH\n}\n\n\nInterface INotifcationMethod{\n    void Notify(Notifacation notifcation):\n}\n\nClass EmailNotifier : INotifcationMethod{\n    string emailId  \n    \n    Void Notify(Notifcation notification){\n         //send email\n    }\n\n}\nClass EmailNotifier : INotifcationMethod{\n    string contactno\n    \n    Void Notify(Notifcation notification){\n         //send message\n    }\n\n}\n\nclass EmailNotifier : INotifcationMethod{\n\n}\n\n\nclass MethodFactory{\n    \n    INotifcationMethod getNotifyMethod (NotificationType \n                                        methidEnum){\n\n        if(methidEnum == 'SMS')\n            return new SMS()\n        else if (methidEnum == 'Email')\n            return new Email ()\n\n        else\n    }\n    \n}\n\n\nclass RetriableNotifierDecorator : INotifcationMethod{\n    INotifcationMethod* Notifier;\n    int maxAttampts\n\n    RetriableNotifierDecorator(INotifcationMethod* notifier, int maxattmpt){\n        this.Notifier = notifier;\n        maxAttampts = maxattampt;\n    }    \n    //OVERRIDE\n    void Notify(Notifcation notification){\n        \n        int delay = 500ms;\n        attmptcount=0;\n\n        while(attemptcount<=maxattmpts){\n            success = notifier.Notify(Notification)\n            if(succee==true) return true;\n        }\n        // delays exponetials if fails\n    }\n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ENUM NotificationType{\n    SMS,\n    EMAIL,\n    PUSH\n}\n\n\nInterface INotifcationMethod{\n    void Notify(Notifacation notifcation):\n}\n\nClass EmailNotifier : INotifcationMethod{\n    string emailId  \n    \n    Void Notify(Notifcation notification){\n         //send email\n    }\n\n}\nClass EmailNotifier : INotifcationMethod{\n    string contactno\n    \n    Void Notify(Notifcation notification){\n         //send message\n    }\n\n}\n\nclass EmailNotifier : INotifcationMethod{\n\n}\n\n\nclass MethodFactory{\n    \n    INotifcationMethod getNotifyMethod (NotificationType \n                                        methidEnum){\n\n        if(methidEnum == 'SMS')\n            return new SMS()\n        else if (methidEnum == 'Email')\n            return new Email ()\n\n        else\n    }\n    \n}\n\n\nclass RetriableNotifierDecorator : INotifcationMethod{\n    INotifcationMethod* Notifier;\n    int maxAttampts\n\n    RetriableNotifierDecorator(INotifcationMethod* notifier, int maxattmpt){\n        this.Notifier = notifier;\n        maxAttampts = maxattampt;\n    }    \n    //OVERRIDE\n    void Notify(Notifcation notification){\n        \n        int delay = 500ms;\n        attmptcount=0;\n\n        while(attemptcount<=maxattmpts){\n            success = notifier.Notify(Notification)\n            if(succee==true) return true;\n        }\n        // delays exponetials if fails\n    }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
