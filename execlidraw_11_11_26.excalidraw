      "updated": 1786888787864,
      "link": null,
      "locked": false,
      "text": "Vending Machine: \nLLD:\n\nFunctional requirements:\n\n1. you can select the items racks\n2. pay for the item (multiple methods)..(optional return change in cash method)\n3. incase of insufficate balance reject request.\n3. denpsing of the item once payment done\n\n\nInsert money -> select item -> despenseitem -> nomoneystate/outofstock\n\n\nRacks\nVandingMachine\nItems\nPayment\nuser -> session\n\nENUM STATUS{\n    INITIATED,\n    PENDING,\n    FAILED\n    SUCCESS\n}\n\nclass payment{\n    string paymentid,\n    Item item\n    int amount\n    STATUS status \n}\n\nInterface IPayment(){\n    Payment pay(payment){}\n}\n\nclass CashPayment : Ipayment{\n      CashRegistry cashregistry;\n      Payment pay(Payment payment){\n            cashregistry.insertmoney(int amount)\n      }\n\n}\n\nclass UPIPayment : Ipayment{\n    \n    Payment pay(Payment payment){\n         //pay using 3rd party gateway\n    }\n}\n\n\n\nInterface IState{\n\n     void InsertMoney(VendingMachine machine){}\n\n     void SelectItem(VendingMachine machine){}\n    \n     void DespenseItem(VendingMachine machine){}\n    \n     void CheckOutOfStock(VendingMachine machine){}\n    \n     void Cancel(VendingMachine machine){}\n\n}\n\n\nclass HasNoMoneyState : IState{\n \n     void InsertMoney(VendingMachine machine, int amount){\n        //update balance\n\n        machine.cashregistry.updatebalance(amount);\n\n        machine.setState(new MoneyInsertState());\n     }\n\n     void SelectItem(VendingMachine machine){\n         //reject request .. stating can;t select item without\n        // inserting money\n\n     }\n    \n     void DespenseItem(VendingMachine machine){}\n    \n     void CheckOutOfStock(VendingMachine machine){\n        int isoutofstock =  machine.inventryservice.checkoutofstock();\n\n        if(isoutofstock)\n            machine.setState(new OutOfStockState());\n     }\n    \n     void Cancel(VendingMachine machine){}\n\n}\n\nclass MoneyInsertedState: IState{\n\n     void InsertMoney(VendingMachine machine){}\n\n     void SelectItem(VendingMachine machine){}\n    \n     void DespenseItem(VendingMachine machine){}\n    \n     void CheckOutOfStock(VendingMachine machine){}\n    \n     void Cancel(VendingMachine machine){}\n\n}\n\nclass DespenseState : IState{\n\n     void InsertMoney(VendingMachine machine, int amount){\n        //reject it ... can't insert money while despensing\n     }\n\n     void SelectItem(VendingMachine machine){}\n    \n     void DespenseItem(VendingMachine machine){}\n    \n     void CheckOutOfStock(VendingMachine machine){}\n    \n     void Cancel(VendingMachine machine){}\n\n}\n\n... do for other states;\n\n\nclass VandingMachine{\nPrivate:\n      \n    IState currentState;\n    VandingMachine* machine;\n    InventryService inventtryservice;\n    CashRegistry cashregistry;  // if insert after select then we can use Ipaymet here\n                                //cashapayment contain cashregistry.\n    mutex mx;\n\n    //singleton\n\n    VandingMachine(IState currstate){\n        currentState = currstate;\n    }\n\nPublic: \n    \n    \n    VendingMachine getVandingMachineobj(IState state){\n        if(machine == null){\n            mx.lock();\n                if(machine == null){\n                    machine  = new VendingMachine(state);  //2nd check for thread2\n                }\n            mx.unlock();\n        }\n        return machine;\n    }\n\n    void setState(ISate newstate){\n        currentstate = newstate;\n    }\n\n    void InsertMoney(Ipayment payment){\n        currentState.InsertMoney(machine, int amount);\n    }\n\n    void SeleteItem(Item item){\n         currentState.SelectItem(machine); //pass machine by refrence\n    }\n\n    void DespenseItem(Item item){\n         currentState.SelectItem(machine);\n    }\n    \n    void CheckOutOfStock(){\n\n    }\n\n    void Cancel(){\n\n    }\n\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vending Machine: \nLLD:\n\nFunctional requirements:\n\n1. you can select the items racks\n2. pay for the item (multiple methods)..(optional return change in cash method)\n3. incase of insufficate balance reject request.\n3. denpsing of the item once payment done\n\n\nInsert money -> select item -> despenseitem -> nomoneystate/outofstock\n\n\nRacks\nVandingMachine\nItems\nPayment\nuser -> session\n\nENUM STATUS{\n    INITIATED,\n    PENDING,\n    FAILED\n    SUCCESS\n}\n\nclass payment{\n    string paymentid,\n    Item item\n    int amount\n    STATUS status \n}\n\nInterface IPayment(){\n    Payment pay(payment){}\n}\n\nclass CashPayment : Ipayment{\n      CashRegistry cashregistry;\n      Payment pay(Payment payment){\n            cashregistry.insertmoney(int amount)\n      }\n\n}\n\nclass UPIPayment : Ipayment{\n    \n    Payment pay(Payment payment){\n         //pay using 3rd party gateway\n    }\n}\n\n\n\nInterface IState{\n\n     void InsertMoney(VendingMachine machine){}\n\n     void SelectItem(VendingMachine machine){}\n    \n     void DespenseItem(VendingMachine machine){}\n    \n     void CheckOutOfStock(VendingMachine machine){}\n    \n     void Cancel(VendingMachine machine){}\n\n}\n\n\nclass HasNoMoneyState : IState{\n \n     void InsertMoney(VendingMachine machine, int amount){\n        //update balance\n\n        machine.cashregistry.updatebalance(amount);\n\n        machine.setState(new MoneyInsertState());\n     }\n\n     void SelectItem(VendingMachine machine){\n         //reject request .. stating can;t select item without\n        // inserting money\n\n     }\n    \n     void DespenseItem(VendingMachine machine){}\n    \n     void CheckOutOfStock(VendingMachine machine){\n        int isoutofstock =  machine.inventryservice.checkoutofstock();\n\n        if(isoutofstock)\n            machine.setState(new OutOfStockState());\n     }\n    \n     void Cancel(VendingMachine machine){}\n\n}\n\nclass MoneyInsertedState: IState{\n\n     void InsertMoney(VendingMachine machine){}\n\n     void SelectItem(VendingMachine machine){}\n    \n     void DespenseItem(VendingMachine machine){}\n    \n     void CheckOutOfStock(VendingMachine machine){}\n    \n     void Cancel(VendingMachine machine){}\n\n}\n\nclass DespenseState : IState{\n\n     void InsertMoney(VendingMachine machine, int amount){\n        //reject it ... can't insert money while despensing\n     }\n\n     void SelectItem(VendingMachine machine){}\n    \n     void DespenseItem(VendingMachine machine){}\n    \n     void CheckOutOfStock(VendingMachine machine){}\n    \n     void Cancel(VendingMachine machine){}\n\n}\n\n... do for other states;\n\n\nclass VandingMachine{\nPrivate:\n      \n    IState currentState;\n    VandingMachine* machine;\n    InventryService inventtryservice;\n    CashRegistry cashregistry;  // if insert after select then we can use Ipaymet here\n                                //cashapayment contain cashregistry.\n    mutex mx;\n\n    //singleton\n\n    VandingMachine(IState currstate){\n        currentState = currstate;\n    }\n\nPublic: \n    \n    \n    VendingMachine getVandingMachineobj(IState state){\n        if(machine == null){\n            mx.lock();\n                if(machine == null){\n                    machine  = new VendingMachine(state);  //2nd check for thread2\n                }\n            mx.unlock();\n        }\n        return machine;\n    }\n\n    void setState(ISate newstate){\n        currentstate = newstate;\n    }\n\n    void InsertMoney(Ipayment payment){\n        currentState.InsertMoney(machine, int amount);\n    }\n\n    void SeleteItem(Item item){\n         currentState.SelectItem(machine); //pass machine by refrence\n    }\n\n    void DespenseItem(Item item){\n         currentState.SelectItem(machine);\n    }\n    \n    void CheckOutOfStock(){\n\n    }\n\n    void Cancel(){\n\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
