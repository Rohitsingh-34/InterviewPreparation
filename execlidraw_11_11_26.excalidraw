      "seed": 279884630,
      "version": 3,
      "versionNonce": 1544443350,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788843193768,
      "link": null,
      "locked": false,
      "text": "👉 Your backend creates the presigned URL.\nS3 does not generate the presigned URL for your application.\n\nClient\n  │\n  │ 1. \"I want to upload file\"\n  ↓\nBackend\n  │\n  │ 2. Authenticate user\n  │ 3. Authorize upload\n  │ 4. Generate presigned URL\n  ↓\nClient\n  │\n  │ 5. PUT file directly\n  ↓\nS3",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "👉 Your backend creates the presigned URL.\nS3 does not generate the presigned URL for your application.\n\nClient\n  │\n  │ 1. \"I want to upload file\"\n  ↓\nBackend\n  │\n  │ 2. Authenticate user\n  │ 3. Authorize upload\n  │ 4. Generate presigned URL\n  ↓\nClient\n  │\n  │ 5. PUT file directly\n  ↓\nS3",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
