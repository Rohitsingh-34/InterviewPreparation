    {
      "id": "s36ntadZBbd_PiWNH4-2l",
      "type": "text",
      "x": -79.18093409942458,
      "y": -186.59735722116102,
      "width": 1045,
      "height": 3250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1834023875,
      "version": 4349,
      "versionNonce": 30189517,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787982265105,
      "link": null,
      "locked": false,
      "text": "Fetch → filter → deduplicate → allocate by proportion\n      → fill shortage → interleave → return\n\n\nSong\nUser \nFilter\nPrefrence \nHistory \nRule\n\nENUM genre( pop, rock.. )\nenum language( enlgish, hindi ,panjabi) \nenum mood(SAD, HAPPY, ROMANTIC)\n\n\nclass prefrence{\n    List<genre> genres\n    List<langugae> langs  \n    list<Mood> moods\n    List<String> excludedSongIds\n\n}\n\nClass MixConfig{\n    int djPrecentage;\n    int recomPercentage;\n\n\n    MaxConfig(int djPertge, int recomPertge){\n        djPercentage = djPertge;\n        recomPercentage = recomPertge\n    }\n\n}\n\nUser{\n    string name\n    int acountno.\n}\n\nSong{\n    int songId\n    enum genre\n    enum mood\n    enum languauge\n    sting songUrl\n}\n\n\n\nAdaptor Pattern:\n\nInterface SongSource{\n    List<Song> fetchSongs(User user, int limit);\n}\n\nClass DJSource : SongSource{\n    DjService djservice  // external api/class\n    \n    List<Songs> fetchSongs(User user, int limit){\n         djservice.getsongs(user,limit);\n    }\n\n}\n\nClass RecomedationSource : SongSource{\n     RecomedationService recomservice  // external api/class\n    \n    List<Songs> fetchSongs(User user, int limit){\n         recomService.getsongs(user,limit);\n    }\n\n}\n\n\n\n\nClass PlayListGenerator{\n    \n    SongSource djsvcOjb;\n    SongSource recomSvcObj;\n\n    SongMixer songmixer\n    SongFilter CompistieSongfilter\n\n\n    List<Songs> getMixSongs(int NoOfSongs, Prefrence prefence, MixConfig mixconfig){\n        \n          List<Songs>   djsongs =  DjSvcObj.fetchSongs(playListsize, prefrence);\n          List<Songs>   recomsong = recomSvcObj.fetchSongs(playListsize, prefreence);\n            \n         List<Songs> filterDJsongs = applyfilters(songs, prefence);\n         List<Songs> filterRecomsongs = applyfilters(recomsongs, prefences);\n\n\n       List<Song> playlist = songmixer->mix(filterdjsing, filteredRecomSongs, mixConfig, size);\n\n        return playlist;\n\n    }\n\n\n    List<Song> applyfilter(List<Song> songs, Prefrence prefrence){\n\n        for(song : songs){\n            CompistieSongfilter->mixSongs(song, prefrences)\n            .toList();\n        }\n    }\n\n}\n\n// pass through the constructor of playgenerator// apply all filter by default \n\nSongFilter playlistFilter = new CompositeSongFilter(List.of(\n    new GenreFilter(),\n    new LanguageFilter(),\n    new MoodFilter()\n));\n\n\n\n\nClass SongsHistory{\n    SongId\n    UserId\n    recomdateCount\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fetch → filter → deduplicate → allocate by proportion\n      → fill shortage → interleave → return\n\n\nSong\nUser \nFilter\nPrefrence \nHistory \nRule\n\nENUM genre( pop, rock.. )\nenum language( enlgish, hindi ,panjabi) \nenum mood(SAD, HAPPY, ROMANTIC)\n\n\nclass prefrence{\n    List<genre> genres\n    List<langugae> langs  \n    list<Mood> moods\n    List<String> excludedSongIds\n\n}\n\nClass MixConfig{\n    int djPrecentage;\n    int recomPercentage;\n\n\n    MaxConfig(int djPertge, int recomPertge){\n        djPercentage = djPertge;\n        recomPercentage = recomPertge\n    }\n\n}\n\nUser{\n    string name\n    int acountno.\n}\n\nSong{\n    int songId\n    enum genre\n    enum mood\n    enum languauge\n    sting songUrl\n}\n\n\n\nAdaptor Pattern:\n\nInterface SongSource{\n    List<Song> fetchSongs(User user, int limit);\n}\n\nClass DJSource : SongSource{\n    DjService djservice  // external api/class\n    \n    List<Songs> fetchSongs(User user, int limit){\n         djservice.getsongs(user,limit);\n    }\n\n}\n\nClass RecomedationSource : SongSource{\n     RecomedationService recomservice  // external api/class\n    \n    List<Songs> fetchSongs(User user, int limit){\n         recomService.getsongs(user,limit);\n    }\n\n}\n\n\n\n\nClass PlayListGenerator{\n    \n    SongSource djsvcOjb;\n    SongSource recomSvcObj;\n\n    SongMixer songmixer\n    SongFilter CompistieSongfilter\n\n\n    List<Songs> getMixSongs(int NoOfSongs, Prefrence prefence, MixConfig mixconfig){\n        \n          List<Songs>   djsongs =  DjSvcObj.fetchSongs(playListsize, prefrence);\n          List<Songs>   recomsong = recomSvcObj.fetchSongs(playListsize, prefreence);\n            \n         List<Songs> filterDJsongs = applyfilters(songs, prefence);\n         List<Songs> filterRecomsongs = applyfilters(recomsongs, prefences);\n\n\n       List<Song> playlist = songmixer->mix(filterdjsing, filteredRecomSongs, mixConfig, size);\n\n        return playlist;\n\n    }\n\n\n    List<Song> applyfilter(List<Song> songs, Prefrence prefrence){\n\n        for(song : songs){\n            CompistieSongfilter->mixSongs(song, prefrences)\n            .toList();\n        }\n    }\n\n}\n\n// pass through the constructor of playgenerator// apply all filter by default \n\nSongFilter playlistFilter = new CompositeSongFilter(List.of(\n    new GenreFilter(),\n    new LanguageFilter(),\n    new MoodFilter()\n));\n\n\n\n\nClass SongsHistory{\n    SongId\n    UserId\n    recomdateCount\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
