      "type": "text",
      "x": 15039.59782438833,
      "y": 11459.18065278518,
      "width": 1124.1995849609375,
      "height": 455,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
