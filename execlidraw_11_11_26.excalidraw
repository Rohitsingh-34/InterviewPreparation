      "created": null
    },
    {
      "id": "HhZFlqeuVNP8Q6l0dBYbh",
      "type": "text",
      "x": -5595.332419913644,
      "y": 1044.5834740251462,
      "width": 530,
      "height": 290,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6K",
      "roundness": null,
      "seed": 2105124515,
      "version": 35,
      "versionNonce": 674281027,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "GAP TO RAISE IN THE INTERVIEW\n=====================================\nThe example charged TWO base rates\n($200 + $160). That is probably wrong.\n\nAsk: are rules ADDITIVE or EXCLUSIVE?\n\n  ADDITIVE   -> regulatory + processing fees\n                all matching rules are summed\n\n  EXCLUSIVE  -> base rate 0.10% OR 0.08%\n                only ONE rule may win\n\nFix: add category + priority to FeeRule\n\n  BASE_FEE    -> exclusive, highest priority wins\n  REGULATORY  -> additive\n  DISCOUNT    -> additive, applied last\n  MIN / MAX   -> clamp the final total",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GAP TO RAISE IN THE INTERVIEW\n=====================================\nThe example charged TWO base rates\n($200 + $160). That is probably wrong.\n\nAsk: are rules ADDITIVE or EXCLUSIVE?\n\n  ADDITIVE   -> regulatory + processing fees\n                all matching rules are summed\n\n  EXCLUSIVE  -> base rate 0.10% OR 0.08%\n                only ONE rule may win\n\nFix: add category + priority to FeeRule\n\n  BASE_FEE    -> exclusive, highest priority wins\n  REGULATORY  -> additive\n  DISCOUNT    -> additive, applied last\n  MIN / MAX   -> clamp the final total",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "MofYwLTHY52JFPEsRvt3T",
      "type": "text",
      "x": -4524.493609659915,
      "y": -792.9076030594838,
      "width": 616,
      "height": 1875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6L",
      "roundness": null,
      "seed": 426957379,
      "version": 1734,
      "versionNonce": 1709635043,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "\n\n\nClass FeeCalculator{\n    \n    List<FeeRule> rules\n\n    FeeCalculator(rules){\n        rules = rules\n    }\n    \n    Compoents Calculate(FeeContext Context){\n         List<FeeComponent> components;\n\n        for(rule : rules){\n            if(rule.matches(context))\n                components.add(rule.calculate(contect));\n        }\n        \n        \n    }\n\n}\n\n\nClass FeeRule{\n    string RuleId\n    List<Condition> condition\n    FeeCalculation feeCalculaton;\n    RuleScope  rulescope\n\n    FeeComponent Calculate(Context){\n        int amount = feecalculaton.Calculate();\n        return new feeComponent(amount, ruleid,...)\n    }\n\n    bool Matches(context){\n        \n        if(!rulescope.supports(context.instruments))\n            return false;\n        \n        for(condition : conditions){\n            if(!condition.metches(context));\n                return false;\n        }\n    }\n\n}\n\nClass FeeComponent{\n    string ruleid\n    FeeCategory category (BASE_FEE, REGULATORY_FEE, ...)\n    float amount\n    string description\n}\n\n\nClass RuleScope{\n    List<InstrumentTypes> instruments;\n\n    bool supports(instrument){\n        if(instrument in instruments)\n            return true;\n    }\n\n}\n\nClass FeeContext{\n\n    InstrumentType instrumenttype\n    float amount\n    Consumer consumer\n    TransactionType TransactionType \n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n\nClass FeeCalculator{\n    \n    List<FeeRule> rules\n\n    FeeCalculator(rules){\n        rules = rules\n    }\n    \n    Compoents Calculate(FeeContext Context){\n         List<FeeComponent> components;\n\n        for(rule : rules){\n            if(rule.matches(context))\n                components.add(rule.calculate(contect));\n        }\n        \n        \n    }\n\n}\n\n\nClass FeeRule{\n    string RuleId\n    List<Condition> condition\n    FeeCalculation feeCalculaton;\n    RuleScope  rulescope\n\n    FeeComponent Calculate(Context){\n        int amount = feecalculaton.Calculate();\n        return new feeComponent(amount, ruleid,...)\n    }\n\n    bool Matches(context){\n        \n        if(!rulescope.supports(context.instruments))\n            return false;\n        \n        for(condition : conditions){\n            if(!condition.metches(context));\n                return false;\n        }\n    }\n\n}\n\nClass FeeComponent{\n    string ruleid\n    FeeCategory category (BASE_FEE, REGULATORY_FEE, ...)\n    float amount\n    string description\n}\n\n\nClass RuleScope{\n    List<InstrumentTypes> instruments;\n\n    bool supports(instrument){\n        if(instrument in instruments)\n            return true;\n    }\n\n}\n\nClass FeeContext{\n\n    InstrumentType instrumenttype\n    float amount\n    Consumer consumer\n    TransactionType TransactionType \n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
