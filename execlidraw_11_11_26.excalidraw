      "link": null,
      "locked": false,
      "text": "class InventryService{\n        //rackid to rack\n    map<string, Rack> rackIdToRack;\n\n    void showItems(){\n        //display all item with quantity\n    }\n\n\n    void removeItem(string RackId){\n        //remove item from the rack\n    }\n\n\n    //admin functoinality\n    void additems(){\n\n    }\n   \n    bool checkOutofStock(){\n        //iterate through the map.. not item then return true;\n    }\n\n}\n\n\nclass Rack{\n    string RackId\n    Item item\n    int quantity\n    int capacity\n}\n\nclass Item{\n    string name\n    int price\n}\n\n\nclass denominatin{\n    //denomiation Rs 1 Rs 5 Rs 10,Rs 50...\n    getchange()\n    updatedenomition()\n}\n\nclass CashRegistry{\n    \n    int sessionBalance;\n    int MachineBalance;\n\n    Denomincation dinomination;\n\n    CashRegistry(){\n\n    } \n\n    bool updateBalance(int amount){\n        sessionbalance += amount;\n    }\n\n    bool CancelSession(){\n        ResetSession();\n    }\n\n    bool ResetSession(){\n        //return that balance to customer;\n        sessionBalance =0;\n    }\n\n   void insertmoney(int amount){\n       //asking user to insert amount\n    \n    }\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class InventryService{\n        //rackid to rack\n    map<string, Rack> rackIdToRack;\n\n    void showItems(){\n        //display all item with quantity\n    }\n\n\n    void removeItem(string RackId){\n        //remove item from the rack\n    }\n\n\n    //admin functoinality\n    void additems(){\n\n    }\n   \n    bool checkOutofStock(){\n        //iterate through the map.. not item then return true;\n    }\n\n}\n\n\nclass Rack{\n    string RackId\n    Item item\n    int quantity\n    int capacity\n}\n\nclass Item{\n    string name\n    int price\n}\n\n\nclass denominatin{\n    //denomiation Rs 1 Rs 5 Rs 10,Rs 50...\n    getchange()\n    updatedenomition()\n}\n\nclass CashRegistry{\n    \n    int sessionBalance;\n    int MachineBalance;\n\n    Denomincation dinomination;\n\n    CashRegistry(){\n\n    } \n\n    bool updateBalance(int amount){\n        sessionbalance += amount;\n    }\n\n    bool CancelSession(){\n        ResetSession();\n    }\n\n    bool ResetSession(){\n        //return that balance to customer;\n        sessionBalance =0;\n    }\n\n   void insertmoney(int amount){\n       //asking user to insert amount\n    \n    }\n}",
