    {
      "id": "0b4aDLEbvS4sccQGZUjJf",
      "type": "text",
      "x": 10003.24505843165,
      "y": 1085.59338717463,
      "width": 554.3997802734375,
      "height": 1190,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 370866040,
      "version": 710,
      "versionNonce": 1059423288,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786687184414,
      "link": null,
      "locked": false,
      "text": "class BlockingQueue{\n    int size;\n    queue<AudioBuffer> q;\n    condition_variable cv;\n    mutex m;\n    \n public:   \n    BlockingQueue(int sz){\n        size = sz\n    }\n\n    void push(AudioBuffer buff){\n        unique_lock<mutex> ul(m);\n        if(q.size()==sz){\n            q.pop();\n            size--;\n        }\n        size++;\n        q.push(buff);\n        cv.notify_one();\n\n    }\n\n    void pop(){\n        unqiue_lock<mutex> ul(m)\n        cv.wait(ul, []{ !q.empty()})\n        if(!size)\n            return;\n        q.pop();\n        size--;\n    }                 \n\n\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class BlockingQueue{\n    int size;\n    queue<AudioBuffer> q;\n    condition_variable cv;\n    mutex m;\n    \n public:   \n    BlockingQueue(int sz){\n        size = sz\n    }\n\n    void push(AudioBuffer buff){\n        unique_lock<mutex> ul(m);\n        if(q.size()==sz){\n            q.pop();\n            size--;\n        }\n        size++;\n        q.push(buff);\n        cv.notify_one();\n\n    }\n\n    void pop(){\n        unqiue_lock<mutex> ul(m)\n        cv.wait(ul, []{ !q.empty()})\n        if(!size)\n            return;\n        q.pop();\n        size--;\n    }                 \n\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "9W86EpYfxhwYI8JBiZ2UV",
      "type": "text",
      "x": 10956.055626105892,
      "y": 954.701067281499,
      "width": 292.5998840332031,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
