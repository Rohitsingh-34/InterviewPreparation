      "updated": 1786682634010,
      "link": null,
      "locked": false,
      "text": "The problem was around designing a system that handles audio buffers across different stages at X frames per second.\n\n100 frames/s meand 1/X -> 10 ms per frame ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The problem was around designing a system that handles audio buffers across different stages at X frames per second.\n\n100 frames/s meand 1/X -> 10 ms per frame ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
