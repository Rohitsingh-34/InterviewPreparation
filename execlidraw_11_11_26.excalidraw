      "updated": 1788116898719,
      "link": null,
      "locked": false,
      "text": "Notification System\n\n1.support multiple notification channel(SMS,Email,Push)\n2.send notification based on priority\n3.retry failed notifacation with exponetial backup\n4.support async operations\n\nENUM NotificationStatus{\n    QUEUED\n    RUNNING\n    COMPLETED \n    FAILED\n\n}\n\n\nENUM NotificationPriority{\n    HIGH(2)\n    LOW(1)\n}\n\nENUM NotificationChannel{\n    SMS\n    EMAIL\n    PUSH\n    WHATSAPP\n}\n\nclass NotificationRequest{\n    userid\n    channel\n    priority\n    scheduledAt\n    params\n}\n\nclass NotificationService{\n    NotificationSenderFactory  senderfactory\n    priority_queue<notification> pqueue //max-heap & create comperator on priority\n    priority_queue<notification> schedulepq //min heap & create compertor on secheduleAt    \n\n    NotificationService(factory){\n        senderfactory = factory\n    }\n    //direct call\n    Notifiaction SendNotification(NotificatonRequest req){\n        \n        //validate the request\n\n        notification = createNotifcation(req)\n        \n        return SendNotificaiton(notifiaction)\n    }\n\n    Notification SendNotificatoin(Notification){\n\n         retryconfig = repo.updateRetryConfig(priority)\n        // update notification with following config\n        \n        if(notification.sechedleat <= now()){   \n            notification.status = 'QUEUED'\n            pqueue.push(notification)\n        }\n        \n        else if(notifcaiton.scheduleAt > now()){\n             notification.status = 'SCHEDULED'\n            \n             schedulePQ.push(notification)\n            \n        }\n    \n         repo.save(notification)\n\n                \n        return notification\n\n    }\n        \n   //moving messages from scheuledqueue to readyqueue\n    void schedulingpool(){\n\n        while(running){\n            if(schedulePQ.empty())\n                return;\n            \n            notification = schedulePQ.top()\n        \n            \n            if(notification.scheduledAt <= now())\n                notification.status = 'QEUEUED'\n                pqueue.push(notification)\n                scheduledPQ.pop()\n                repo.save(notification)\n\n            \n        }\n\n    }\n\n\n    Notification aquireNotification(){\n        \n        if(pqueue.empty())\n           return null\n    \n        notification = pqueue.top()\n        \n        pqueue.pop()\n\n        notification.status='RUNNING'\n\n        repo.save(notification)\n\n        return notification\n    }\n\n}\n\n\nclass Notification{\n    id\n    userid\n    channel\n    priority\n    params\n    retrycount\n    retrymaxcount\n    basedelay\n    secheduledAt\n    status\n    \n}\n\nclass NotificationSenderFactory{\n    \n    INotificationSender getNotifcationSender(NotificationChannel channel){\n\n            if(channle == 'SMS')\n                return new SMSSender()\n            else if(channel == 'EMAIL')\n                return new EMAILSender()\n    }\n\n}\n\n\nInterface INotificationSender{\n\n    bool Send(Notificatoin){}\n\n}\n\n\nSMSSender : INotificationSender{\n\n    bool Send(Notification){\n        //call 3rd party api to send sms\n    }\n}\n\n\nEmailSender : INotificationSender{\n\n    bool Send(Notification){\n        //call 3rd party api to send sms\n    }\n}\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notification System\n\n1.support multiple notification channel(SMS,Email,Push)\n2.send notification based on priority\n3.retry failed notifacation with exponetial backup\n4.support async operations\n\nENUM NotificationStatus{\n    QUEUED\n    RUNNING\n    COMPLETED \n    FAILED\n\n}\n\n\nENUM NotificationPriority{\n    HIGH(2)\n    LOW(1)\n}\n\nENUM NotificationChannel{\n    SMS\n    EMAIL\n    PUSH\n    WHATSAPP\n}\n\nclass NotificationRequest{\n    userid\n    channel\n    priority\n    scheduledAt\n    params\n}\n\nclass NotificationService{\n    NotificationSenderFactory  senderfactory\n    priority_queue<notification> pqueue //max-heap & create comperator on priority\n    priority_queue<notification> schedulepq //min heap & create compertor on secheduleAt    \n\n    NotificationService(factory){\n        senderfactory = factory\n    }\n    //direct call\n    Notifiaction SendNotification(NotificatonRequest req){\n        \n        //validate the request\n\n        notification = createNotifcation(req)\n        \n        return SendNotificaiton(notifiaction)\n    }\n\n    Notification SendNotificatoin(Notification){\n\n         retryconfig = repo.updateRetryConfig(priority)\n        // update notification with following config\n        \n        if(notification.sechedleat <= now()){   \n            notification.status = 'QUEUED'\n            pqueue.push(notification)\n        }\n        \n        else if(notifcaiton.scheduleAt > now()){\n             notification.status = 'SCHEDULED'\n            \n             schedulePQ.push(notification)\n            \n        }\n    \n         repo.save(notification)\n\n                \n        return notification\n\n    }\n        \n   //moving messages from scheuledqueue to readyqueue\n    void schedulingpool(){\n\n        while(running){\n            if(schedulePQ.empty())\n                return;\n            \n            notification = schedulePQ.top()\n        \n            \n            if(notification.scheduledAt <= now())\n                notification.status = 'QEUEUED'\n                pqueue.push(notification)\n                scheduledPQ.pop()\n                repo.save(notification)\n\n            \n        }\n\n    }\n\n\n    Notification aquireNotification(){\n        \n        if(pqueue.empty())\n           return null\n    \n        notification = pqueue.top()\n        \n        pqueue.pop()\n\n        notification.status='RUNNING'\n\n        repo.save(notification)\n\n        return notification\n    }\n\n}\n\n\nclass Notification{\n    id\n    userid\n    channel\n    priority\n    params\n    retrycount\n    retrymaxcount\n    basedelay\n    secheduledAt\n    status\n    \n}\n\nclass NotificationSenderFactory{\n    \n    INotificationSender getNotifcationSender(NotificationChannel channel){\n\n            if(channle == 'SMS')\n                return new SMSSender()\n            else if(channel == 'EMAIL')\n                return new EMAILSender()\n    }\n\n}\n\n\nInterface INotificationSender{\n\n    bool Send(Notificatoin){}\n\n}\n\n\nSMSSender : INotificationSender{\n\n    bool Send(Notification){\n        //call 3rd party api to send sms\n    }\n}\n\n\nEmailSender : INotificationSender{\n\n    bool Send(Notification){\n        //call 3rd party api to send sms\n    }\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "0cyyjpM9uo0vzjX1ulSq3",
      "type": "text",
      "x": 60326.90528219782,
