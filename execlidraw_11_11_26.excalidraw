      "link": null,
      "locked": false,
      "text": "BorrowingPolicy\n\nList<BorrowingRule> rules;\n\nvoid addrule(Borrowing rule){\n    rules.add(rule)\n}\n\nbool ValidateRules(BookingRequest){\n    \n    for(auto rule: rules){\n        isvalid =rule.isvalud(BookingRequest)\n        if(isvalid ==false)\n            return false;\n    }\n\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BorrowingPolicy\n\nList<BorrowingRule> rules;\n\nvoid addrule(Borrowing rule){\n    rules.add(rule)\n}\n\nbool ValidateRules(BookingRequest){\n    \n    for(auto rule: rules){\n        isvalid =rule.isvalud(BookingRequest)\n        if(isvalid ==false)\n            return false;\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
