      "updated": 1786472993639,
      "link": null,
      "locked": false,
      "text": "Interface MixingStrategy{\n    \n    List<Song> mix(List<Song> djSongs,\n                   List<Song> recomSongs,\n                   MixConfig  mixconfig,\n                   int        size);\n\n}\n\n\nClass SongMixer{\n\n    List<Song> mix(List<Song> djSongs,\n                   List<Song> recomSongs,\n                   MixConfig  mixconfig,\n                   int        size)\n    {\n        // 1. Remove duplicates\n        // 2. Calculate source quotas\n        // 3. Select songs\n        // 4. Fill shortages from the other source\n        // 5. Interleave selected songs\n        // 6. Return complete or partial playlist\n    }\n\n}\n\n\n\nInterface ISongFilter{\n\n    List<Song> matches(Song song\n                       Prefrence prefrences);\n    \n}\n\nClass GenreFilter : ISongFilter{\n\n    List<Song> matches(Song song\n                       Prefrence prefrences){\n\n                if(prefrence.genre == song.genre)\n            \n    }\n\n}\n\nClass CompositeSongFilter: ISongFilter{\n\n    List<ISongFilter> filters;\n\n    CompositeSongFilter(List<ISongFilter> filters){\n            this.filters = filters\n    }\n\n    List<Song> matches(Song song\n                       Prefrence prefrences){\n\n                for(filter: filtes){\n                    if(filter.matches(song,prefrence))\n                 }\n    }\n    \n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interface MixingStrategy{\n    \n    List<Song> mix(List<Song> djSongs,\n                   List<Song> recomSongs,\n                   MixConfig  mixconfig,\n                   int        size);\n\n}\n\n\nClass SongMixer{\n\n    List<Song> mix(List<Song> djSongs,\n                   List<Song> recomSongs,\n                   MixConfig  mixconfig,\n                   int        size)\n    {\n        // 1. Remove duplicates\n        // 2. Calculate source quotas\n        // 3. Select songs\n        // 4. Fill shortages from the other source\n        // 5. Interleave selected songs\n        // 6. Return complete or partial playlist\n    }\n\n}\n\n\n\nInterface ISongFilter{\n\n    List<Song> matches(Song song\n                       Prefrence prefrences);\n    \n}\n\nClass GenreFilter : ISongFilter{\n\n    List<Song> matches(Song song\n                       Prefrence prefrences){\n\n                if(prefrence.genre == song.genre)\n            \n    }\n\n}\n\nClass CompositeSongFilter: ISongFilter{\n\n    List<ISongFilter> filters;\n\n    CompositeSongFilter(List<ISongFilter> filters){\n            this.filters = filters\n    }\n\n    List<Song> matches(Song song\n                       Prefrence prefrences){\n\n                for(filter: filtes){\n                    if(filter.matches(song,prefrence))\n                 }\n    }\n    \n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
