    },
    {
      "id": "QIC5z3lZ1CLFq-aIJaKBs",
      "type": "text",
      "x": 14940.934030752454,
      "y": 10760.52981917257,
      "width": 1195.3125,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1560827062,
      "version": 375,
      "versionNonce": 1723030710,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788554361830,
      "link": null,
      "locked": false,
      "text": "Redis Cluster is the way to go here because it handles the routing and failover automatically. \nThe cluster manages hash slots, and our gateway clients can connect directly to the cluster without\n needing custom routing logic. If a shard goes down, the cluster handles promotion of replicas. \nWe'll need to size our shards appropriately - maybe 10-15 shards to keep each one well under its \nthroughput limits, with room for traffic spikes. The key is making sure that the client key hashing is\n deterministic so we don't have the same client hitting different shards.\"",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 139,
      "containerId": null,
      "originalText": "Redis Cluster is the way to go here because it handles the routing and failover automatically. \nThe cluster manages hash slots, and our gateway clients can connect directly to the cluster without\n needing custom routing logic. If a shard goes down, the cluster handles promotion of replicas. \nWe'll need to size our shards appropriately - maybe 10-15 shards to keep each one well under its \nthroughput limits, with room for traffic spikes. The key is making sure that the client key hashing is\n deterministic so we don't have the same client hitting different shards.\"",
      "lineHeight": 1.2,
      "index": "bC5",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "qxVWj0YuXXQyMbgVuSSJi",
      "type": "text",
      "x": 14922.512587829513,
      "y": 9204.761790222401,
      "width": 222.65625,
      "height": 96,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2110279158,
      "version": 413,
      "versionNonce": 751982070,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788554361830,
      "link": null,
      "locked": false,
      "text": "consistenst hashing\n- some users move\nfrom multiple node \nto new node",
