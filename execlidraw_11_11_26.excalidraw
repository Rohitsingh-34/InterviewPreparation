    {
      "id": "QvDyFz7Y6qBwhTGiDWtrE",
      "type": "text",
      "x": 21987.20487627183,
      "y": 10915.435322626376,
      "width": 960.9375,
      "height": 24,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
