    {
      "id": "IZK2XMSePOz9iqVn3YgfZ",
      "type": "text",
      "x": 40166.28467040294,
      "y": 10801.024882083615,
      "width": 608.2451171875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
