    {
      "id": "oA9jbvx1Tp_n5EVH2i2to",
      "type": "text",
      "x": 13323.599652122974,
      "y": 8715.751879610782,
      "width": 208.04557551789424,
      "height": 168.86822887425666,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
