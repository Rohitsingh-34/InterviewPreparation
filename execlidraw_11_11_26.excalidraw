      "updated": 1787005662219,
      "link": null,
      "locked": false,
      "text": "class UserPreferenceRepo{\n    map<string, List<NotficationsType>> UserCategory_TO_Channels;\n    \n       List<INotifcationMethod> getMethodByUser(int userid){\n    \n                //filter from userToTYpe\n                return Notifymethods;\n        }\n    \n     bool OptIn(List<INotifactionMethod> MethodType){\n            //update userToTypes\n     }\n\n     bool OptOut(List<INotifactionMethod> types){\n            //remove from userToTypes\n     }\n    \n}\n\n\nClass NotifyServive{\n     UserPreferenceRepo prefrepo;\n     private final NotificationScheduler scheduler;\n\n    \n    void Notify(Notifcation notifcation, User user){\n        \n        List<INotifcationMethod> notifyMethods = prefrepo.getMethodByUser(user.userid)\n\n        for(method: notifyMethods )\n            method.Notify(notifacation);\n    }\n\n    void schedule(Notifcation notification, User user, Date Time){\n         \n        scheduler.scheduleNotification(Notifcation);\n     \n    }\n\n\n}\n\n\nClass NotificationMangager{\n\n    UserPreferenceRepo prefrepo;\n\n     bool OptIn(List<INotifactionMethod> MethodType){\n            //update userToTypes\n     }\n\n     bool OptOut(List<INotifactionMethod> types){\n            //remove from userToTypes\n     }\n   \n\n}\n\nENUM Catergory{\n    MARKETING\n    ORDER\n    UPDATES\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class UserPreferenceRepo{\n    map<string, List<NotficationsType>> UserCategory_TO_Channels;\n    \n       List<INotifcationMethod> getMethodByUser(int userid){\n    \n                //filter from userToTYpe\n                return Notifymethods;\n        }\n    \n     bool OptIn(List<INotifactionMethod> MethodType){\n            //update userToTypes\n     }\n\n     bool OptOut(List<INotifactionMethod> types){\n            //remove from userToTypes\n     }\n    \n}\n\n\nClass NotifyServive{\n     UserPreferenceRepo prefrepo;\n     private final NotificationScheduler scheduler;\n\n    \n    void Notify(Notifcation notifcation, User user){\n        \n        List<INotifcationMethod> notifyMethods = prefrepo.getMethodByUser(user.userid)\n\n        for(method: notifyMethods )\n            method.Notify(notifacation);\n    }\n\n    void schedule(Notifcation notification, User user, Date Time){\n         \n        scheduler.scheduleNotification(Notifcation);\n     \n    }\n\n\n}\n\n\nClass NotificationMangager{\n\n    UserPreferenceRepo prefrepo;\n\n     bool OptIn(List<INotifactionMethod> MethodType){\n            //update userToTypes\n     }\n\n     bool OptOut(List<INotifactionMethod> types){\n            //remove from userToTypes\n     }\n   \n\n}\n\nENUM Catergory{\n    MARKETING\n    ORDER\n    UPDATES\n}",
