    {
      "id": "-__0o_AMuP7eJw62-IBZj",
      "type": "text",
      "x": 25085.475090569413,
      "y": 9336.208636604071,
      "width": 1001,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFb",
      "roundness": null,
      "seed": 1367199382,
      "version": 42,
      "versionNonce": 1763581002,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788642854308,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n\n1. Upstream services should be able to send a notification to a user \n    via push, email, or SMS, either immediately or in the future.\n2. Upstream services should be able to send campaigns, the same message \n    delivered to a whole segment of users, immediately or scheduled.\n3. Users should be able to set notification preferences (channel opt-outs and quiet hours).",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n\n1. Upstream services should be able to send a notification to a user \n    via push, email, or SMS, either immediately or in the future.\n2. Upstream services should be able to send campaigns, the same message \n    delivered to a whole segment of users, immediately or scheduled.\n3. Users should be able to set notification preferences (channel opt-outs and quiet hours).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "u_i1BDeKR47-TNcV1E9LQ",
      "type": "text",
      "x": 27351.1069194255,
      "y": 11624.986273482,
      "width": 1166,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFc",
      "roundness": null,
      "seed": 261172746,
      "version": 292,
      "versionNonce": 695429194,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788643665836,
      "link": null,
      "locked": false,
      "text": " - rate limiiter here on worker because ex provider have limited rates\n   which is bascially equivivalent to the keeping bucket for out 1000 req/sec -> keep 200/sec for crictal \n                                                                            and keep 800/sec for bulk",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " - rate limiiter here on worker because ex provider have limited rates\n   which is bascially equivivalent to the keeping bucket for out 1000 req/sec -> keep 200/sec for crictal \n                                                                            and keep 800/sec for bulk",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "tbEnDC8A-sq5TZh9g3SB-",
      "type": "text",
      "x": 27364.577440880123,
      "y": 11769.527320922325,
      "width": 1056,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
