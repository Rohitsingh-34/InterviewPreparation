    },
    {
      "id": "M2kHhTwYna-BTFmDhUiDd",
      "type": "text",
      "x": 55434.63091317269,
      "y": 10456.230218746898,
      "width": 323.3998718261719,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJT",
