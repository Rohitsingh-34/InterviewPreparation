    {
      "id": "5GOZqcDNTr5XYPbLM7KaO",
      "type": "text",
      "x": -5675.332419913644,
      "y": 594.5834740251462,
      "width": 610,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6F",
      "roundness": null,
      "seed": 1701861507,
      "version": 35,
      "versionNonce": 1682943011,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "PER REQUEST  (per transaction)\n===================================\n\n1. TradeController.calculateFee(request)\n            |\n2. TradeService.calculateTradeFee(request)\n            |\n3. builds FeeContext\n      { instrument, amount, customer, txnType }\n            |\n4. feeCalculator.calculate(context)\n            |\n      for each FeeRule:\n            |\n      5. rule.matches(context)\n            |-- scope.supports(instrument)\n            |-- condition.matches(context)   [ALL must pass]\n            |\n      6. if matched -> rule.calculate(context)\n                          |-- feeCalculation.calculate(context)\n                                 <-- FORMULA RUNS HERE\n            |\n7. sum all FeeComponents -> FeeResult (breakdown + total)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PER REQUEST  (per transaction)\n===================================\n\n1. TradeController.calculateFee(request)\n            |\n2. TradeService.calculateTradeFee(request)\n            |\n3. builds FeeContext\n      { instrument, amount, customer, txnType }\n            |\n4. feeCalculator.calculate(context)\n            |\n      for each FeeRule:\n            |\n      5. rule.matches(context)\n            |-- scope.supports(instrument)\n            |-- condition.matches(context)   [ALL must pass]\n            |\n      6. if matched -> rule.calculate(context)\n                          |-- feeCalculation.calculate(context)\n                                 <-- FORMULA RUNS HERE\n            |\n7. sum all FeeComponents -> FeeResult (breakdown + total)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
