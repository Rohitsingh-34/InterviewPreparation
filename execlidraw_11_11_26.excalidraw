      "updated": 1788172144573,
      "link": null,
      "locked": false,
      "text": "chain of responsibility\n\n\n\nclass IFilter{\n    \n    Bool IsValid(Requestobj){}\n\n}\n\n\n\nclass AuthFilter: IFilter{\n    IFilter* nextfilter\n    \n    AuthFilter(Ifilter* filter=null){\n        nextfilter = filter\n    }\n    \n    Bool IsValid(RequestObj){\n        \n        if(requestobj.token != 'token1')\n               return false\n        \n        if(nextfilter ==null)\n            return\n        nextfilter.IsValid(requestObj)\n\n    }\n\n}\n\n\nIfilter = new AuthFilter(new ExeptionFilter())",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "chain of responsibility\n\n\n\nclass IFilter{\n    \n    Bool IsValid(Requestobj){}\n\n}\n\n\n\nclass AuthFilter: IFilter{\n    IFilter* nextfilter\n    \n    AuthFilter(Ifilter* filter=null){\n        nextfilter = filter\n    }\n    \n    Bool IsValid(RequestObj){\n        \n        if(requestobj.token != 'token1')\n               return false\n        \n        if(nextfilter ==null)\n            return\n        nextfilter.IsValid(requestObj)\n\n    }\n\n}\n\n\nIfilter = new AuthFilter(new ExeptionFilter())",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "5oOYtMrtPlqkiMhQ7UKB6",
      "type": "text",
      "x": 63696.73135664292,
      "y": -2045.5315259103782,
      "width": 723.7996826171875,
      "height": 1575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9e",
      "roundness": null,
      "seed": 853023341,
      "version": 566,
      "versionNonce": 1420557869,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788172146523,
      "link": null,
      "locked": false,
      "text": "Composite Pattern\n\nInterface IFilter{\n\n  result filter(reqobj){}\n}\n\n\nclass Genrefilter: IFilter{\n    \n    \n  song[] filter(song[]){\n        //filter songs on genre\n  }\n\n}\n\nclass Titlefilter: IFilter{\n    \n    \n  song[] filter(song[]){\n        //filter songs on genre\n  }\n\n}\n\n\nclass compositeFilter{\n    filter[] filters\n    \n    addfilter(filter){\n        filters.push(filter)\n    }\n\n    song[] filter(song[]){\n        newsong[]= song[]\n        for(filter: filters)\n            newsing[] =filter.filternewwsong[])\n         \n        return newsong[]\n    }\n\n\n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Composite Pattern\n\nInterface IFilter{\n\n  result filter(reqobj){}\n}\n\n\nclass Genrefilter: IFilter{\n    \n    \n  song[] filter(song[]){\n        //filter songs on genre\n  }\n\n}\n\nclass Titlefilter: IFilter{\n    \n    \n  song[] filter(song[]){\n        //filter songs on genre\n  }\n\n}\n\n\nclass compositeFilter{\n    filter[] filters\n    \n    addfilter(filter){\n        filters.push(filter)\n    }\n\n    song[] filter(song[]){\n        newsong[]= song[]\n        for(filter: filters)\n            newsing[] =filter.filternewwsong[])\n         \n        return newsong[]\n    }\n\n\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
