    {
      "id": "DzPaXNFrOVzJQ6DLR38FO",
      "type": "text",
      "x": 49361.04625599893,
      "y": -3372.1662500073717,
      "width": 1647.7996826171875,
      "height": 10045,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8R",
      "roundness": null,
      "seed": 1496729837,
      "version": 37,
      "versionNonce": 1030455469,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788086276959,
      "link": null,
      "locked": false,
      "text": "AMAZON LOCKER\n\n// ═══════════════════════════════════════════════════════════════════════════\n// REQUIREMENTS\n//\n// Example (Tic Tac Toe):\n//   1. Two players alternate placing X and O on a 3x3 grid.\n//   2. A player wins by completing a row, column, or diagonal.\n//   Out of Scope: UI, AI opponent, networking\n// ═══════════════════════════════════════════════════════════════════════════\n\nRequirements:\n1. driver should able to deposit package by specifying size (small, medium, large)\n   - system assigns available compartment of exact matching size (strict match, no fallback to larger size)\n   - if no compartment of that size is available, system rejects deposit with error\n   - on success, system opens compartment and generates a unique access code\n\n2. customer puts that code and takes package\n   - system validates code before opening compartment\n   - if code is invalid or expired, system rejects with clear error message\n   - once package is picked up, code is marked as used and cannot be reused\n\n3. locker can be of diff size (small, medium, large)\n\n4. customer should able to return package and generate code\n   - system assigns available compartment for return\n   - generates new code for driver to retrieve\n\n5. using that code driver should able to retrieve that package\n\n6. access codes expire after 7 days\n   - expired codes are rejected if customer tries to use them\n   - package stays in compartment after expiry until staff removes it manually\n   - staff can trigger open of all compartments with expired codes to handle packages\n\nError handling:\n- no compartment available of requested size -> deposit rejected, error returned\n- customer enters wrong/invalid code -> rejected with \"invalid code\" error\n- customer enters expired code -> rejected with \"code expired\" error\n- code already used -> rejected with \"code already used\" error\n\n\n// ═══════════════════════════════════════════════════════════════════════════\n// ENTITIES & RELATIONSHIPS\n//\n// Example (Tic Tac Toe):\n//   Game, Board, Player\n// ═══════════════════════════════════════════════════════════════════════════\n\nLocker\nCompartmant\nenum size\nlockerRepository\nAccessToken\n\n\n// ═══════════════════════════════════════════════════════════════════════════\n// CLASS DESIGN\n//\n// Example (Tic Tac Toe):\n//   class Game:\n//     - board: Board\n//     - currentPlayer: Player\n//     + makeMove(row, col) -> bool\n// ═══════════════════════════════════════════════════════════════════════════\n\nclass Locker{\n    lockerRepository lockrepo\n    TokenHandler tokenhandler\n\n    tokenid depositPackage(size){\n        Compartmant comp = lockrepo.getAvaibleComparment(size);\n\n        if(comp == NULL)\n            return \"comparetments are not aviable\"\n\n        issuccess = lockrepo.openCompartment(comp);\n\n        if(issuccess)\n            issubimited = lockrepo.submitcompartment(comp);\n\n        if(!lockrepo.markedComparmentOccupied(comp))\n            return \"compartment don't have package\"\n\n        if(issubimited)\n            generatetoken = tokenhandler.generatetoken(comp)\n        return generatetoken\n    }\n\n    bool getpackage(tokenid){\n        if(tokenhandler.isTokenValid(tokenid)){\n            token = tokenhandler.gettoken(tokenid)\n            lockrepo.openCompartment(token.compartment)\n            lockrepo.closecompartment(comp)\n\n            tokenhandler.Deletetoken(tokenid);\n            return true;\n           }\n    }\n\n    openExpiredCompartments(){\n\n    }\n    //cron job or background job\n    resetExpireReserveComp(){\n        lockrepo.cleanReserveExpiry();\n    }\n\n}\n\nclass lockerRepository{\n    Map<size,Compartment[]> compartments\n    Ilockerassignstrategy stragey;\n    //map<size, size[]> sizemap //sorted size[] list  small -> small , med, large\n                                                //  med  -> med , lrge   && large -> large\n\n    compartment getAvaibleComparment(size){\n\n        return stragey.getAvaibleComparment(size, comparetments);\n    }\n\n    bool openCompartment(comp){\n        comp.openCompartment();\n    }\n\n    bool submitcompartment(size){\n        return updatestatus(\"CLOSED\");\n    }\n\n    bool closecompartment(comp){\n        comp.updatestatus(\"AVAIBLE\");\n    }\n\n    bool markedComparmentOccupied(comp){\n        return comp.markedComparmentOccupied(comp)\n    }\n\n\n    comparmentNumber getpackage(tokenid){\n\n    }\n\n    openExpiredComparments(){\n\n    }\n    \n    cleanReserveExpiry(){\n        //check expirey time for each reserve comparment \n        //and update its status to avaiable again\n    }\n}\n\nclass compartment{\n    int comparmentNumber\n    Size size\n    Status status \n    Status sensorstatus\n    date reserveExpTime\n    mutex mt\n\n    bool isvalidComparment(sz){\n        mt.lock(comparmentNumber)\n        if(sz <= size && status == \"AVAIBLE\"){\n            status = \"RESERVE\";\n            reserveExpTime = utcnow+5min\n            return true;\n        }\n    }\n\n    Status updatestatus(status){\n        status = status;\n    }\n\n    status openCompartment(){\n        status = \"OPEN\";\n    }\n\n    void updatesensorstatus(status){\n        sensorstatus = status\n    }\n\n    bool markedComparmentOccupied(){\n\n        if(sensorstatus == \"package_NOT_IN\"){\n            status = \"avaiable\"\n            RETURN false\n        }\n        status = 'OCCUPIED'\n        return true;\n    }\n\n}\n\nclass tokenhandler{\n    map<tokenid,token> tokens\n\n    token generatetoken(comp){\n        tokenstring = //generate from inbuilt function\n        expirytime = utcnow+7day\n\n        token = new token(tokenstring, expirytime, comp)\n        tokens[tokenid] = token;\n        return token;\n    }\n\n    \n    bool deleteToken(tokenid){\n        token.isactive = false;\n    }\n\n}\n\nclass token{\n    string tokenid\n    string token\n    date expirytime \n    compartment comp\n    IsActive\n    user[]  \n\n    bool isTokenValid(user){\n        \n    }\n\n    bool istokenexpire(){\n\n    }\n}\n\nenum Size{\n    SMALL(1),\n    MEDIUM(5),\n    LARGE(10)\n}\n\nenum Status{\n    AVAILABLE,\n    OCCUPIED,\n    OPENED,\n    OUT_OF_SERVICE\n}\n\n\n// ═══════════════════════════════════════════════════════════════════════════\n// IMPLEMENTATION\n// ═══════════════════════════════════════════════════════════════════════════\n\n\n// ═══════════════════════════════════════════════════════════════════════════\n// EXTENSIBILITY\n// ═══════════════════════════════════════════════════════════════════════════\n\n\ninterface Ilockerassignstrategy{\n\n    comparment getAvaibleComparment(size,compatmetn){ }\n}\n\n\nexactmatchstrategy : Ilockerassignstrategy{\n    comparment getAvaibleComparment(size,comparmtens){\n        //expact matach\n\n     }\n\n}\n\nfallbackonBigstrategy : Ilockerassignstrategy{\n        map<size, size[]> sizemap //sorted size[] list  small -> small , med, large\n\n    comparment getAvaibleComparment(size, comparments){\n\n        size[] szlist = sizemap[size]\n\n        for(sz: szlist){\n        for(comp : compartments[sz]){\n            if(comp.isvalidComparment(sz))\n                return compartment;\n        }\n        }\n        return NULL;\n     }\n\n}\n\n\n",
