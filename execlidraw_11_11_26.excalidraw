      ],
      "updated": 1788154800444,
      "link": null,
      "locked": false,
      "text": "Ticket Booking System:\n\n1. User can select seat and make payment ... seat booked\n2. Seat can be silver, gold, premium\n3. shows are already added insystem by admin\n4. accept multiple payment method\n5. user should able to search based location, show ... \n\nnon func\n1. handle concurrency on seat booking\n2. follow solid and extensible \n\n\n\n\nEntity:\nUser\nShow\nSeat\nPayment\nBooking\n\nenum SeatType{\n    SILVER\n    GOLD\n    PALTIMNUM\n    VIP\n}\n\nENUM STATUS{\n    AVAIABLE\n    OCCUPIED\n    RESERVE\n}\n\n\nclass PaymentHandler{\n    Ipayment paymentmethod;\n\n    PaymentHandler(Ipayment paymentmethod){\n        this.paymentmethod = paymentmethod\n    }\n\n    bool makepayment(Booking booking){\n        return paymentmethod.pay(booking);\n    }\n    \n}\n\nClass Seat{\n    string seatid //unique accross shows\n    string seatNumber\n    SeatType  seattype\n    Status  status //remove it\n    float   price  //moved to the showseat\n}\n\nClass Show{\n    string showid\n    string name\n    Date  showstarttime\n    float duration\n    string screenid;\n}\n\nclass Threater{\n    string ThreterId\n    string name\n    List<Screen> screens;\n    float lat\n    float long\n    string city\n}\n\nclass Screen{\n    string screenid\n    string threaderid\n}\n\nClass Booking{\n    string bookingid\n    string showid\n    int noOfSeats;\n    List<string> seatids\n    float amount\n    BookingStatus status(Initialed, PENDING, BOOKED, CANCELED)\n}\n\nclass ShowSeat{\n    string showId,\n    string seatId,\n    STATUS status\n    float price\n\n}\n\nclass SeatAllocator{\n    map<string, List<ShowSeat>> ShowId_To_ShowSeat;\n    mutex maplock;\n    map<string, Mutex> showid_to_lock;\n\n    getshowlock(show){\n        maplock.lock();\n        if(showid_to_lock[showid].empty()){\n            showid_to_lock[showid] = new mutex();\n        }\n        return showid_to_lock[showid];\n    }  \n\nPublic:         \n    bool ReserveSeat(Booking booking){\n\n        int showid = booking.showid;\n\n        mutex showMutex = getshowlock(showid);\n        \n        showMutex.lock()  //auto release once moved out of stock\n         \n        List<ShowSeat> showseats = ShowId_To_ShowSeat[showid];\n\n        for(auto seat : showseats){\n            if(booking.seats.find(seatid) && seat.status == 'RESERVE'){\n                return false;\n            }\n        }\n        \n        for(auto seat : showseats){\n            seat.status = 'RESERVE'\n        }\n        \n        return true;\n\n    }\n\n    bool DeAllocateSeats(Booking booking){\n         //make status from reserved to avaiable\n          return true;\n    }\n}\n\n\nclass bookingService{\n     List<Show> shows\n     SeatAllocator seatallocator;\n     PaymentHandler paymentHandler;\n\n    bookingService(List<Show> shows){\n        this.shows = shows\n    }\n\n    Booking bookseat(Booking booking){\n        \n        bool isreserved = seatallocator.ReserveSeat(booking);\n    \n        if(!isreserved){\n            booking.status = canceled;\n            return booking;\n        }\n\n        bool ispaid = paymentHandler.pay(booking);\n\n        if(ispaid){\n            seatallocator.UpdateSeatStatus(booking,bookstatus);\n            return booking;\n        }\n        else\n            seatallocator.DeAllocateSeats(booking);\n        \n    }\n    \n\n}\n\n\nclass TicketBookingSystem{\n    IBookingService bookingsvc\n    ISearchService searchsvc;\n\n    TicketBookingSystem(IBookingService Bsvc, ISearchServices SSvc){\n        bookingsvc = Bsvc;\n        searchsvc = SSvc;\n    }\n\n    List<Show> findShow(Filter filter){\n            return searchsvc.findshow(searchsvc);\n    }\n    \n    Booking BookSeat(Booking booking){\n        return bookingsvc.bookseat(Booking booking);\n    }\n}\n\nclass SearchService{\n    List<Threater> threaters;\n\n    List<Show> findShow(IFilter filter){\n        //filter list based on the filter\n         return list;\n    }\n\n\n}\n\nclass Filter{\n    string showname\n    Date date\n    float long\n    float lat \n}\n\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ticket Booking System:\n\n1. User can select seat and make payment ... seat booked\n2. Seat can be silver, gold, premium\n3. shows are already added insystem by admin\n4. accept multiple payment method\n5. user should able to search based location, show ... \n\nnon func\n1. handle concurrency on seat booking\n2. follow solid and extensible \n\n\n\n\nEntity:\nUser\nShow\nSeat\nPayment\nBooking\n\nenum SeatType{\n    SILVER\n    GOLD\n    PALTIMNUM\n    VIP\n}\n\nENUM STATUS{\n    AVAIABLE\n    OCCUPIED\n    RESERVE\n}\n\n\nclass PaymentHandler{\n    Ipayment paymentmethod;\n\n    PaymentHandler(Ipayment paymentmethod){\n        this.paymentmethod = paymentmethod\n    }\n\n    bool makepayment(Booking booking){\n        return paymentmethod.pay(booking);\n    }\n    \n}\n\nClass Seat{\n    string seatid //unique accross shows\n    string seatNumber\n    SeatType  seattype\n    Status  status //remove it\n    float   price  //moved to the showseat\n}\n\nClass Show{\n    string showid\n    string name\n    Date  showstarttime\n    float duration\n    string screenid;\n}\n\nclass Threater{\n    string ThreterId\n    string name\n    List<Screen> screens;\n    float lat\n    float long\n    string city\n}\n\nclass Screen{\n    string screenid\n    string threaderid\n}\n\nClass Booking{\n    string bookingid\n    string showid\n    int noOfSeats;\n    List<string> seatids\n    float amount\n    BookingStatus status(Initialed, PENDING, BOOKED, CANCELED)\n}\n\nclass ShowSeat{\n    string showId,\n    string seatId,\n    STATUS status\n    float price\n\n}\n\nclass SeatAllocator{\n    map<string, List<ShowSeat>> ShowId_To_ShowSeat;\n    mutex maplock;\n    map<string, Mutex> showid_to_lock;\n\n    getshowlock(show){\n        maplock.lock();\n        if(showid_to_lock[showid].empty()){\n            showid_to_lock[showid] = new mutex();\n        }\n        return showid_to_lock[showid];\n    }  \n\nPublic:         \n    bool ReserveSeat(Booking booking){\n\n        int showid = booking.showid;\n\n        mutex showMutex = getshowlock(showid);\n        \n        showMutex.lock()  //auto release once moved out of stock\n         \n        List<ShowSeat> showseats = ShowId_To_ShowSeat[showid];\n\n        for(auto seat : showseats){\n            if(booking.seats.find(seatid) && seat.status == 'RESERVE'){\n                return false;\n            }\n        }\n        \n        for(auto seat : showseats){\n            seat.status = 'RESERVE'\n        }\n        \n        return true;\n\n    }\n\n    bool DeAllocateSeats(Booking booking){\n         //make status from reserved to avaiable\n          return true;\n    }\n}\n\n\nclass bookingService{\n     List<Show> shows\n     SeatAllocator seatallocator;\n     PaymentHandler paymentHandler;\n\n    bookingService(List<Show> shows){\n        this.shows = shows\n    }\n\n    Booking bookseat(Booking booking){\n        \n        bool isreserved = seatallocator.ReserveSeat(booking);\n    \n        if(!isreserved){\n            booking.status = canceled;\n            return booking;\n        }\n\n        bool ispaid = paymentHandler.pay(booking);\n\n        if(ispaid){\n            seatallocator.UpdateSeatStatus(booking,bookstatus);\n            return booking;\n        }\n        else\n            seatallocator.DeAllocateSeats(booking);\n        \n    }\n    \n\n}\n\n\nclass TicketBookingSystem{\n    IBookingService bookingsvc\n    ISearchService searchsvc;\n\n    TicketBookingSystem(IBookingService Bsvc, ISearchServices SSvc){\n        bookingsvc = Bsvc;\n        searchsvc = SSvc;\n    }\n\n    List<Show> findShow(Filter filter){\n            return searchsvc.findshow(searchsvc);\n    }\n    \n    Booking BookSeat(Booking booking){\n        return bookingsvc.bookseat(Booking booking);\n    }\n}\n\nclass SearchService{\n    List<Threater> threaters;\n\n    List<Show> findShow(IFilter filter){\n        //filter list based on the filter\n         return list;\n    }\n\n\n}\n\nclass Filter{\n    string showname\n    Date date\n    float long\n    float lat \n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "UhTaKhTGCHCCG5Is1mQfj",
