      "seed": 2114934509,
      "version": 748,
      "versionNonce": 502052195,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788034250980,
      "link": null,
      "locked": false,
      "text": "ParkingAllocator\n\n-Level[] levels\n\n\nSpot getSpot(vehicaletype){\n    \n    for(level: levels){\n        level.getspot(vehicletype);\n        \n    }\n}\n\nbool confirmHold(spot){\n    return spot.updatestate('Occupied')\n}\n\nbool releasespot(spot){\n    return spit.updatestatus('Avaiable')\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ParkingAllocator\n\n-Level[] levels\n\n\nSpot getSpot(vehicaletype){\n    \n    for(level: levels){\n        level.getspot(vehicletype);\n        \n    }\n}\n\nbool confirmHold(spot){\n    return spot.updatestate('Occupied')\n}\n\nbool releasespot(spot){\n    return spit.updatestatus('Avaiable')\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
