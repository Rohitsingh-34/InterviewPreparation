      "boundElements": [],
      "updated": 1788642736654,
      "link": null,
      "locked": false,
      "text": "- You were very close to a full no drop design, but you did not \nclose the gap between accepting the API request and getting the \nnotification durably into Kafka. In your design the notification \nservice still talks to both the database and Kafka as separate actions,\n so a crash after writing one but before the other can strand accepted \nwork with no durable delivery signal, which breaks the guarantee",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 139,
      "containerId": null,
      "originalText": "- You were very close to a full no drop design, but you did not \nclose the gap between accepting the API request and getting the \nnotification durably into Kafka. In your design the notification \nservice still talks to both the database and Kafka as separate actions,\n so a crash after writing one but before the other can strand accepted \nwork with no durable delivery signal, which breaks the guarantee",
      "lineHeight": 1.2,
      "index": "bFE",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
