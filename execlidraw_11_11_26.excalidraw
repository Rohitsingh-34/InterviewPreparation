      "updated": 1788151422662,
      "link": null,
      "locked": false,
      "text": "LibraryService\n-bookRepoObj\n-bookingRepoObj\n-bookingPolicyObj\n-bookingRulesObj\n\nBook[] SearchBooks(string keyword){\n    return bookinfRepoObj.getbooks(keyword)\n}\n\nint borrowBook(BookRequest[] requestoj){\n    Book book = bookRepoObj.getBookdetails(req.bookid);\n    isvalid = bookingPolicyObj.validateRules(reqObj);\n    BookCopy copy = book.getAvaiableCopy();\n    return bookingrepoObj.saveborrowing(copy,reqobj);\n}\n\nint returnBook(BorrowingId){\n   borrowing = borrowingRepoObj.getBorrowing(borrowingId)\n   BookCopy copy= bookrepoobj.getBookCopy(borrowing.copyid);\n   int fine= borrowingRulesObj.calculateFine(borrowing);\n    isfineFinepaid=falase;\n    if(fine !=0){\n        //asking for fine\n        //route it to paymentgateway\n        isfinepaid = true;\n    }\n    borrowing.updatestatus('RETURNED');\n    if(isfinepaid=true)\n        bookingRepoObj.closeborrowing(borrowing);\n        copy.updatestatus('AVAIBLE')\n      \n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LibraryService\n-bookRepoObj\n-bookingRepoObj\n-bookingPolicyObj\n-bookingRulesObj\n\nBook[] SearchBooks(string keyword){\n    return bookinfRepoObj.getbooks(keyword)\n}\n\nint borrowBook(BookRequest[] requestoj){\n    Book book = bookRepoObj.getBookdetails(req.bookid);\n    isvalid = bookingPolicyObj.validateRules(reqObj);\n    BookCopy copy = book.getAvaiableCopy();\n    return bookingrepoObj.saveborrowing(copy,reqobj);\n}\n\nint returnBook(BorrowingId){\n   borrowing = borrowingRepoObj.getBorrowing(borrowingId)\n   BookCopy copy= bookrepoobj.getBookCopy(borrowing.copyid);\n   int fine= borrowingRulesObj.calculateFine(borrowing);\n    isfineFinepaid=falase;\n    if(fine !=0){\n        //asking for fine\n        //route it to paymentgateway\n        isfinepaid = true;\n    }\n    borrowing.updatestatus('RETURNED');\n    if(isfinepaid=true)\n        bookingRepoObj.closeborrowing(borrowing);\n        copy.updatestatus('AVAIBLE')\n      \n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
