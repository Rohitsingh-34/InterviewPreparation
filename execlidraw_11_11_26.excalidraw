    {
      "id": "Nip-xpxOPtDIqxi1CXcON",
      "type": "text",
      "x": 69990.03593565794,
      "y": -3859.529194343001,
      "width": 800,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
