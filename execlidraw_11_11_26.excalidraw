    {
      "id": "baSC_CB_8DM-neFEHqZYQ",
      "type": "text",
      "x": 16182.879842540875,
      "y": -1045.9383254657,
      "width": 1324.3994140625,
      "height": 6545,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
