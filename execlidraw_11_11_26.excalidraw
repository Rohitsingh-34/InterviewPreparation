      "boundElements": [],
      "updated": 1788005044694,
      "link": null,
      "locked": false,
      "text": "LiftManager\n\n-Lift lift\n-LiftStatus status\n-Floor currentFloor\n-MinHeap minheap\n-MaxHeap maxheap\n\nbool addrequest(req){\n    queue.push(req.destfloor)\n}\n\n//continurely checking\nprocess(){\n    while(running && !q.empty()){\n     \n      if(floor==currfloor)\n       floor = q.top()\n      else if(moving up)\n        currfloor++\n      else\n        currfloor--;\n    }       \n\n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LiftManager\n\n-Lift lift\n-LiftStatus status\n-Floor currentFloor\n-MinHeap minheap\n-MaxHeap maxheap\n\nbool addrequest(req){\n    queue.push(req.destfloor)\n}\n\n//continurely checking\nprocess(){\n    while(running && !q.empty()){\n     \n      if(floor==currfloor)\n       floor = q.top()\n      else if(moving up)\n        currfloor++\n      else\n        currfloor--;\n    }       \n\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
