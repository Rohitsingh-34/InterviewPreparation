      "text": "orchestrator\n\nList<Floor> floors\nElevatorService elsvc\n\n\nrequest = floors.pressupbutton()\n\nelsvc.placerequest(request)\n\n\nbutton = lift.getfloorbutton();\n\nrequest = button.press()\n\nleftcontroller.addrequest(request);",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "orchestrator\n\nList<Floor> floors\nElevatorService elsvc\n\n\nrequest = floors.pressupbutton()\n\nelsvc.placerequest(request)\n\n\nbutton = lift.getfloorbutton();\n\nrequest = button.press()\n\nleftcontroller.addrequest(request);",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
