    },
    {
      "id": "3SuNxyh0jtrbJRA9PuAMU",
      "type": "text",
      "x": 16296.213749587067,
      "y": 9712.163081265027,
      "width": 199.21875,
      "height": 72,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1413073014,
      "version": 376,
      "versionNonce": 1046597750,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788554361830,
      "link": null,
      "locked": false,
      "text": "ratelimiter1 -> 8\nretelimiter2 -> 8\nratelimiter3 -> 8",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 67,
      "containerId": null,
      "originalText": "ratelimiter1 -> 8\nretelimiter2 -> 8\nratelimiter3 -> 8",
      "lineHeight": 1.2,
      "index": "bC8",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "x64ooPLKYBGzjw2RWCOIp",
      "type": "text",
      "x": 15401.369199664352,
      "y": 10135.510228363075,
      "width": 1289.0625,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1041582518,
      "version": 370,
      "versionNonce": 905728438,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788554361830,
      "link": null,
      "locked": false,
      "text": "High availability starts with preventing failures in the first place by replica and redis cluster promote that\n\nOn the gateway side, we need proper timeouts and circuit breakers. \nIf Redis is slow or unavailable, we can't let that hang our gateways.\n We need to decide on a failure mode: fail-open (allow all traffic) or \n fail-closed (block all traffic).",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 139,
      "containerId": null,
      "originalText": "High availability starts with preventing failures in the first place by replica and redis cluster promote that\n\nOn the gateway side, we need proper timeouts and circuit breakers. \nIf Redis is slow or unavailable, we can't let that hang our gateways.\n We need to decide on a failure mode: fail-open (allow all traffic) or \n fail-closed (block all traffic).",
      "lineHeight": 1.2,
      "index": "bC9",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "MIJ6-Vh3XYKMPUF4eW704",
      "type": "text",
      "x": 15468.923607477083,
      "y": 10345.039970862186,
      "width": 785.15625,
      "height": 24,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2070848246,
      "version": 384,
      "versionNonce": 2132050474,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788591959999,
      "link": null,
      "locked": false,
      "text": "- should choose failed closed for the social media or viral content",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 19,
      "containerId": null,
      "originalText": "- should choose failed closed for the social media or viral content",
      "lineHeight": 1.2,
      "index": "bCA",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "3Q-Sz9x_JSkg4ssRHC2NZ",
      "type": "text",
      "x": 16453.76474469418,
      "y": 10559.41187546246,
      "width": 1488.28125,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 248173622,
      "version": 281,
      "versionNonce": 1854921782,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788554361830,
      "link": null,
      "locked": false,
      "text": "\"To minimize latency, we need to optimize every part of the path. First, I'll use persistent connection pools from our gateways\n to Redis - creating new connections for every request would add significant handshake overhead.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 43,
      "containerId": null,
      "originalText": "\"To minimize latency, we need to optimize every part of the path. First, I'll use persistent connection pools from our gateways\n to Redis - creating new connections for every request would add significant handshake overhead.",
      "lineHeight": 1.2,
      "index": "bCB",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "_gb1T-dAi7Ws6Z7ZrP56M",
      "type": "text",
      "x": 16453.76474469418,
      "y": 10627.41187546246,
      "width": 1546.875,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1645141366,
      "version": 281,
      "versionNonce": 334685558,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788554361830,
      "link": null,
      "locked": false,
      "text": "Colocation is key. We want our gateways and Redis instances in the same data center, ideally the same rack, to keep network latency \nunder a millisecond. Cross-region calls would add 50-100ms which is way too much.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 43,
      "containerId": null,
      "originalText": "Colocation is key. We want our gateways and Redis instances in the same data center, ideally the same rack, to keep network latency \nunder a millisecond. Cross-region calls would add 50-100ms which is way too much.",
      "lineHeight": 1.2,
      "index": "bCC",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "Xu1mKg0nDJjLOaRbNEc1D",
      "type": "text",
      "x": 16453.76474469418,
      "y": 10695.41187546246,
      "width": 1523.4375,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1518321334,
      "version": 281,
      "versionNonce": 1117963958,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788554361830,
      "link": null,
      "locked": false,
      "text": "For the rate limiting logic itself, I'll implement everything as a single Lua script. This avoids multiple round trips to Redis - \ninstead of separate GET, calculate, SET operations, we do it all atomically in one script execution.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 43,
      "containerId": null,
      "originalText": "For the rate limiting logic itself, I'll implement everything as a single Lua script. This avoids multiple round trips to Redis - \ninstead of separate GET, calculate, SET operations, we do it all atomically in one script execution.",
      "lineHeight": 1.2,
      "index": "bCD",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "P83n6G-LmYlHtVO6VcT8Q",
      "type": "text",
      "x": 16453.76474469418,
      "y": 10763.41187546246,
      "width": 1523.4375,
      "height": 96,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1824684022,
      "version": 283,
      "versionNonce": 1799651318,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788554361830,
      "link": null,
      "locked": false,
      "text": "For global scale, we'll deploy regional clusters. A user in Asia hits the Asia cluster, Europe users hit the Europe cluster, etc. \nThis means rate limits might not be perfectly consistent across regions - a user could potentially get 100 requests in Asia and \nanother 100 in Europe - but the alternative is adding huge latency for cross-region synchronization. For most use cases, \nthis eventual consistency is acceptable.\"",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 91,
      "containerId": null,
      "originalText": "For global scale, we'll deploy regional clusters. A user in Asia hits the Asia cluster, Europe users hit the Europe cluster, etc. \nThis means rate limits might not be perfectly consistent across regions - a user could potentially get 100 requests in Asia and \nanother 100 in Europe - but the alternative is adding huge latency for cross-region synchronization. For most use cases, \nthis eventual consistency is acceptable.\"",
      "lineHeight": 1.2,
      "index": "bCE",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "4qKwrwanKDF95kzRIittJ",
      "type": "text",
      "x": 16455.711152926782,
      "y": 10390.217042451002,
      "width": 1359.375,
      "height": 72,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 819726646,
      "version": 325,
      "versionNonce": 1166840726,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788732146476,
      "link": null,
      "locked": false,
      "text": "The better mental model is to use Redis pipelining to send multiple commands to Redis in a single network round trip\n without waiting for each response individually, but still making the allow or deny decision atomically per request\n using a Lua script.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 67,
      "containerId": null,
      "originalText": "The better mental model is to use Redis pipelining to send multiple commands to Redis in a single network round trip\n without waiting for each response individually, but still making the allow or deny decision atomically per request\n using a Lua script.",
      "lineHeight": 1.2,
      "index": "bCF",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "29hmo8vEGWxfgI-CWmYKB",
      "type": "text",
      "x": 16715.83905712449,
      "y": 9363.107074123818,
      "width": 1253.90625,
      "height": 96,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1982952054,
      "version": 355,
      "versionNonce": 1325700490,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788607505968,
      "link": null,
      "locked": false,
      "text": "Use push-based updates as the default here. Store rules in ZooKeeper or a config service, and have each \ngateway watch for changes or receive a pub-sub notification, then refresh its local rule cache immediately.\n This matters because an emergency throttling rule takes effect quickly across all gateways. Rules stay in \nthe config store, while per-user request counters stay in Redis.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 91,
      "containerId": null,
      "originalText": "Use push-based updates as the default here. Store rules in ZooKeeper or a config service, and have each \ngateway watch for changes or receive a pub-sub notification, then refresh its local rule cache immediately.\n This matters because an emergency throttling rule takes effect quickly across all gateways. Rules stay in \nthe config store, while per-user request counters stay in Redis.",
      "lineHeight": 1.2,
      "index": "bCG",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
