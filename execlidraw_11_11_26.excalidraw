      "link": null,
      "locked": false,
      "text": "class BlockingQueue{\n    queue<int> queue\n    mutex mt\n    condition_variable cv\n\n\n    void push(int val){\n        mt.lock()\n        q.push(val)\n        cv.notify() // notify sleeping thread\n    }\n    \n    void pop(){\n        mt.lock()\n        cv.wait(lock, !q.empty()) // if q is empty lock release and thread is went to sleep\n            q.pop()\n    }\n\n    int front(){\n        if(!q.empty())\n            q.front()\n    }\n\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class BlockingQueue{\n    queue<int> queue\n    mutex mt\n    condition_variable cv\n\n\n    void push(int val){\n        mt.lock()\n        q.push(val)\n        cv.notify() // notify sleeping thread\n    }\n    \n    void pop(){\n        mt.lock()\n        cv.wait(lock, !q.empty()) // if q is empty lock release and thread is went to sleep\n            q.pop()\n    }\n\n    int front(){\n        if(!q.empty())\n            q.front()\n    }\n\n}",
      "autoResize": true,
