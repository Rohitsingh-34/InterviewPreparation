    {
      "id": "c9Q7WwRPQFucI6_h0_NcT",
      "type": "text",
      "x": -4530.164834477727,
      "y": 1128.423935103658,
      "width": 671,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6R",
      "roundness": null,
      "seed": 1939409923,
      "version": 879,
      "versionNonce": 1500245923,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "Orchesrator{\n    FeeRuleLoader feeRuleLoader;\n    List<feeRule> feerules = feeRuleLoader.loadconfig(config)\n    \n    feeCalculator = new Feecalculator(feerules)\n    FeeContext context(amount, consumer,\"STOCK\",);\n\n    feeCalculator.calculate(context);\n    \n}\n\n\n\nFeeRuleLoader{\n\n  condition{\n       1. amount > 10000\n       2.  customerType is PREMIMUM\n  }\n    \n    Conditionfactory.getConditionObj(customerType,config);\n\n    FeeRuleFactory.getRuleObj(ruleType, config);\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Orchesrator{\n    FeeRuleLoader feeRuleLoader;\n    List<feeRule> feerules = feeRuleLoader.loadconfig(config)\n    \n    feeCalculator = new Feecalculator(feerules)\n    FeeContext context(amount, consumer,\"STOCK\",);\n\n    feeCalculator.calculate(context);\n    \n}\n\n\n\nFeeRuleLoader{\n\n  condition{\n       1. amount > 10000\n       2.  customerType is PREMIMUM\n  }\n    \n    Conditionfactory.getConditionObj(customerType,config);\n\n    FeeRuleFactory.getRuleObj(ruleType, config);\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "tnZ7pfb46gJit2_c4AUIB",
      "type": "text",
