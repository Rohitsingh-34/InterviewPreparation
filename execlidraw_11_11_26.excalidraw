      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 9833.146570715331,
      "y": 10927.69584946776,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
