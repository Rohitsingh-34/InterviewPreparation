      "baseFontSize": null
    },
    {
      "id": "6DdBvCreDmx2Kir4715Xq",
      "type": "text",
      "x": 19065.401642356006,
      "y": 12550.625516010332,
      "width": 659.9990844726562,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
