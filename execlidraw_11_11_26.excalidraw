    },
    {
      "id": "koE_fmPpWP92fsNg9bdPu",
      "type": "text",
      "x": 58539.33988512615,
      "y": 8568.5039858946,
      "width": 1031.7996826171875,
      "height": 1890,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJg",
      "roundness": null,
      "seed": 1571128150,
      "version": 1213,
      "versionNonce": 1845573910,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788728451818,
      "link": null,
      "locked": false,
      "text": "Uber ride sharing system:\n\n\nFunctional requirement:\n\n- rider should be able to get fair for give start and drop location\n- rider should able to book the ride for the given fair\n- driver should able to accept the rider's request\n- rider should able to see live location of driver\n\n\n\n\nNon-Functional Requirement:\n\n- strong consisteny on ride assignement to driver\n- aviablity on search \n- latency of < 1 min on ride booking\n- pick scale of 5k request per second per area\n\n\n\nCore Entities: \n\n- rider\n- driver\n- booking\n- location\n- Fair\n\n\n\nAPI:\n\n\nGET ride/fair?startloc={}&&endloction={}  -> Fair\n\n\nPost ride/request-> Ride\n{\n    fairid\n}\n\n\nPost ride/driver/acceptride -> Ride\n{\n    Rideid\n}\n\nPost driver/location -> 200\n{\n    lat\n    long\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uber ride sharing system:\n\n\nFunctional requirement:\n\n- rider should be able to get fair for give start and drop location\n- rider should able to book the ride for the given fair\n- driver should able to accept the rider's request\n- rider should able to see live location of driver\n\n\n\n\nNon-Functional Requirement:\n\n- strong consisteny on ride assignement to driver\n- aviablity on search \n- latency of < 1 min on ride booking\n- pick scale of 5k request per second per area\n\n\n\nCore Entities: \n\n- rider\n- driver\n- booking\n- location\n- Fair\n\n\n\nAPI:\n\n\nGET ride/fair?startloc={}&&endloction={}  -> Fair\n\n\nPost ride/request-> Ride\n{\n    fairid\n}\n\n\nPost ride/driver/acceptride -> Ride\n{\n    Rideid\n}\n\nPost driver/location -> 200\n{\n    lat\n    long\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
