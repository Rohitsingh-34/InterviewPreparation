      "boundElements": [],
      "updated": 1788119617152,
      "link": null,
      "locked": false,
      "text": "\n\nTicket ParkVechicle(Vehicle){\n   spot = parkingallocator.getSpot();\n\n   ticket = ticketgenerator.generateTicket(vehicale,spot)\n   parkingallocator.confirmHold(spot);\n   return ticket;   \n}\n\n\nTicket ExitVehicle(ticketId){\n  ticket =  existrequest(ticketid);\n\n  issucces=  parkingallocator.releaseSpot(ticket.spot)\n  return ticket\n}",
      "fontSize": 27.057928931919406,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nTicket ParkVechicle(Vehicle){\n   spot = parkingallocator.getSpot();\n\n   ticket = ticketgenerator.generateTicket(vehicale,spot)\n   parkingallocator.confirmHold(spot);\n   return ticket;   \n}\n\n\nTicket ExitVehicle(ticketId){\n  ticket =  existrequest(ticketid);\n\n  issucces=  parkingallocator.releaseSpot(ticket.spot)\n  return ticket\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "c0NZv8aNi3EFl7g1xoO1v",
      "type": "text",
      "x": 43966.3253447458,
      "y": -1192.0800216090765,
      "width": 615.999755859375,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7l",
