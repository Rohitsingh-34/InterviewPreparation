    {
      "id": "Y94Kp-RgpZunr2LU-Wi_g",
      "type": "text",
      "x": -83.20703026594231,
      "y": -541.2503939760362,
      "width": 880,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
