      "updated": 1788150578643,
      "link": null,
      "locked": false,
      "text": "LibraryService\n\n-bookRepoObj\n-borrwoingRulesObj\n\nBook[] SearchBooks(string keyword){\n    return bookRepoObj.getbooks(keyword)\n}\n\nint borrowBook(BookRequest[] requestoj){\n    return bookrepoObj.borrowBook(requestoj);\n}\n\nint returnBook(BookRequest[] requestoj){\n   int fine= borrowingRulesObj.calculateFine(borrowingId);\n    isfineFinepaid=falase;\n    if(fine !=0){\n        //asking for fine\n        //route it to paymentgateway\n        isfinepaid = true;\n    }\n\n    if(isfinepaid=true)\n        bookRepoObj.returnBook(BookRequest[]);\n      \n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LibraryService\n\n-bookRepoObj\n-borrwoingRulesObj\n\nBook[] SearchBooks(string keyword){\n    return bookRepoObj.getbooks(keyword)\n}\n\nint borrowBook(BookRequest[] requestoj){\n    return bookrepoObj.borrowBook(requestoj);\n}\n\nint returnBook(BookRequest[] requestoj){\n   int fine= borrowingRulesObj.calculateFine(borrowingId);\n    isfineFinepaid=falase;\n    if(fine !=0){\n        //asking for fine\n        //route it to paymentgateway\n        isfinepaid = true;\n    }\n\n    if(isfinepaid=true)\n        bookRepoObj.returnBook(BookRequest[]);\n      \n}",
