      "link": null,
      "locked": false,
      "text": "LiftController\n\n-Lift lift\n-MinHeap uprequests\n-MaxHeap downrequests\n-Set set;\n-mutex mt\n\nbool addrequest(floorRequest){\n    mt.lock()\n    if(set.count(floor))\n    queue.push(req.destfloor)\n}\n\nstep(){     \n      if(floor==currfloor)\n       floor = q.top()\n      else if(moving up)\n        currfloor++\n      else\n        currfloor--;\n         \n}\n\n \n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LiftController\n\n-Lift lift\n-MinHeap uprequests\n-MaxHeap downrequests\n-Set set;\n-mutex mt\n\nbool addrequest(floorRequest){\n    mt.lock()\n    if(set.count(floor))\n    queue.push(req.destfloor)\n}\n\nstep(){     \n      if(floor==currfloor)\n       floor = q.top()\n      else if(moving up)\n        currfloor++\n      else\n        currfloor--;\n         \n}\n\n \n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
