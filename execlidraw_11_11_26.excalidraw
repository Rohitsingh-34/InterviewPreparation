    {
      "id": "pkUyZqWwBkW267LCpmKpe",
      "type": "text",
      "x": 29723.761007162357,
      "y": 6025.158518884826,
      "width": 1742.39892578125,
      "height": 1035,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4K",
      "roundness": null,
      "seed": 736334499,
      "version": 35,
      "versionNonce": 728547171,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787980186856,
      "link": null,
      "locked": false,
      "text": "For a good OO LLD design, no. Entities should have behavior related to their own state. \n\nBut they should not coordinate the entire use case.\n\nThink of it this way\n\nBookCopy owns this state:\n\nstatus = AVAILABLE / BORROWED / RESERVED\n\nSo it makes sense for BookCopy to control transitions of that state:\n\n\n\nA simple rule to remember\n\nAsk:\n\n\"Does this logic primarily concern the state/invariant of this object?\"\n\nIf yes → put it in the entity.\n\nIf no → probably put it in a service/policy/etc.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For a good OO LLD design, no. Entities should have behavior related to their own state. \n\nBut they should not coordinate the entire use case.\n\nThink of it this way\n\nBookCopy owns this state:\n\nstatus = AVAILABLE / BORROWED / RESERVED\n\nSo it makes sense for BookCopy to control transitions of that state:\n\n\n\nA simple rule to remember\n\nAsk:\n\n\"Does this logic primarily concern the state/invariant of this object?\"\n\nIf yes → put it in the entity.\n\nIf no → probably put it in a service/policy/etc.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
