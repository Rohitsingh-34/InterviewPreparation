    {
      "id": "cGSK-DYEFDH4193Rs5Tgu",
      "type": "text",
      "x": 54233.41375169295,
      "y": 9998.286626153083,
      "width": 1509.19970703125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJP",
      "roundness": null,
      "seed": 1534583562,
      "version": 9,
      "versionNonce": 8710538,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788718806326,
      "link": null,
      "locked": false,
      "text": "For payments, I prioritize correctness and durability over availability.\nA temporary failure should result in UNKNOWN/PROCESSING, not a potentially incorrect FAILED state.",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For payments, I prioritize correctness and durability over availability.\nA temporary failure should result in UNKNOWN/PROCESSING, not a potentially incorrect FAILED state.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "K8XEe1qEEEnXTmK10a6Yd",
      "type": "text",
      "x": 55669.671623281014,
      "y": 9035.688265407889,
      "width": 246.39990234375,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
