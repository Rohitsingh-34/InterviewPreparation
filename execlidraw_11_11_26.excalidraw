    },
    {
      "id": "Dxgs32lvfPUZugLY19OV2",
      "type": "text",
      "x": 77704.75582142468,
      "y": 11542.758985983091,
      "width": 1770.9996337890625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMt",
      "roundness": null,
      "seed": 74797718,
      "version": 7,
      "versionNonce": 577939030,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788811825007,
      "link": null,
      "locked": false,
      "text": "The vending machine reports the dispense result after the physical dispensing operation. \nIdeally, the machine uses a sensor to confirm that the item actually dropped. We track a unique \ntransaction/dispense ID and states such as DISPENSE_REQUESTED, DISPENSED and DISPENSE_FAILED. \nIf the machine crashes or the response is lost, we mark the dispense as UNKNOWN rather than immediately refunding, \nand reconcile with the machine before initiating compensation.\"",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The vending machine reports the dispense result after the physical dispensing operation. \nIdeally, the machine uses a sensor to confirm that the item actually dropped. We track a unique \ntransaction/dispense ID and states such as DISPENSE_REQUESTED, DISPENSED and DISPENSE_FAILED. \nIf the machine crashes or the response is lost, we mark the dispense as UNKNOWN rather than immediately refunding, \nand reconcile with the machine before initiating compensation.\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "9N7ewGWu-VLOtlWsKoIf4",
      "type": "text",
      "x": 36004.85309215469,
      "y": 17070.33391109667,
      "width": 785.3997802734375,
      "height": 735,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMu",
      "roundness": null,
      "seed": 830543434,
      "version": 485,
      "versionNonce": 1089494858,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788840830711,
      "link": null,
      "locked": false,
      "text": "urlshortner \n\n- user will give you long url\n- redirect them to short url\n\n\nnfr\n- aviability > consistency \n- latency of rediect should be low <100ms\n- scalable to 100k qps\n\n\n\n\n- urlmapping\n- shorturl\n- longurl\n\n\n301 -> permanet rediect(brower cache)\n302 -> temporary redirect(fetch again from backend)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "urlshortner \n\n- user will give you long url\n- redirect them to short url\n\n\nnfr\n- aviability > consistency \n- latency of rediect should be low <100ms\n- scalable to 100k qps\n\n\n\n\n- urlmapping\n- shorturl\n- longurl\n\n\n301 -> permanet rediect(brower cache)\n302 -> temporary redirect(fetch again from backend)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
