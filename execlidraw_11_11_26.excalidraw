      "isDeleted": false,
      "boundElements": [],
      "updated": 1788642736654,
      "link": null,
      "locked": false,
      "text": "Post /notifications -> Notification\n{\n    notificationmethod (email,sms)\n    template\n    //user fetch from header  \n    scheduleTime\n    timestamp\n} \n\n\nPost /compaigns -> Compaign\n{\n    notificationId\n    scheduleTime\n    segment\n}\n \n//user from header\nPost users/{userId}/prefrence -> prefrences\n{\n    optin/optout\n    slienttime\n    channel\n}",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 571,
      "containerId": null,
      "originalText": "Post /notifications -> Notification\n{\n    notificationmethod (email,sms)\n    template\n    //user fetch from header  \n    scheduleTime\n    timestamp\n} \n\n\nPost /compaigns -> Compaign\n{\n    notificationId\n    scheduleTime\n    segment\n}\n \n//user from header\nPost users/{userId}/prefrence -> prefrences\n{\n    optin/optout\n    slienttime\n    channel\n}",
