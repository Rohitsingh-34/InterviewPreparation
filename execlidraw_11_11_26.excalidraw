    {
      "id": "P1AS8ENpdSDdRaFXQNaJc",
      "type": "rectangle",
      "x": 15351.222763363454,
      "y": 9428.136994789906,
      "width": 96.28940038646942,
      "height": 65.78778695834126,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
