      "seed": 361969229,
      "version": 327,
      "versionNonce": 963594179,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787980186856,
      "link": null,
      "locked": false,
      "text": "The library management system should allow librarians to manage books, members, and borrowing activities.\nMember should able to search books based book title,auther,subject\nThe system should support adding, updating, and removing books from the library catalog.\nEach book should have details such as title, author, ISBN, publication year, and availability status.\nThe system should allow members to borrow and return books.\nEach member should have details such as name, member ID, contact information, and borrowing history.\nThe system should enforce borrowing rules, such as a maximum number of books that can be borrowed at a time and loan duration.\nThe system should handle concurrent access to the library catalog and member records.\nThe system should be extensible to accommodate future enhancements and new features.",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The library management system should allow librarians to manage books, members, and borrowing activities.\nMember should able to search books based book title,auther,subject\nThe system should support adding, updating, and removing books from the library catalog.\nEach book should have details such as title, author, ISBN, publication year, and availability status.\nThe system should allow members to borrow and return books.\nEach member should have details such as name, member ID, contact information, and borrowing history.\nThe system should enforce borrowing rules, such as a maximum number of books that can be borrowed at a time and loan duration.\nThe system should handle concurrent access to the library catalog and member records.\nThe system should be extensible to accommodate future enhancements and new features.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
