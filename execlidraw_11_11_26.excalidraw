      "seed": 844577659,
      "version": 366,
      "versionNonce": 684432821,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787684517338,
      "link": null,
      "locked": false,
      "text": "Logger/Logging System:\n\n-system should support diff log level(debug,info,warn,err)\n-log message contains (timestamp, message, level)\n-system should support multiple destination\n-diff applications should able to configure to levels\n- single application logs at multiple dest\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Logger/Logging System:\n\n-system should support diff log level(debug,info,warn,err)\n-log message contains (timestamp, message, level)\n-system should support multiple destination\n-diff applications should able to configure to levels\n- single application logs at multiple dest\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "bWUpnJUqoJ5fpEuKLWtns",
      "type": "text",
      "x": 19544.201202454606,
      "y": -1273.7138905714223,
      "width": 785.399658203125,
      "height": 2275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 1261510101,
      "version": 1031,
      "versionNonce": 2068537691,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787686134209,
      "link": null,
      "locked": false,
      "text": "\nENUM Level{\n    DEBUG, 4\n    INFO,  3\n    WARN,  2\n    ERR   1\n}\n\nclass log{\n    string logId\n    Level  level\n    string message\n    Date   timestamp\n}\n\n\nclass ILogLevel{\n    \n    void log(Log log){}\n    \n}\n\nclass DebugLevel : IlogLevel{\n\n    LogRepository logrepo;\n\n    void log(Log log){\n         logrepo.savelog(log);       \n     }\n\n}\n\nclass WarnLevel : IlogLevel{\n\n    void log(Log log){\n        //log message as Warn\n    }\n\n}\n\nclass logger{\n    Level minLevel; //pull from config\n    map<Level,int> levelno\n\n     void logDebug(Log log){\n        if(levelno[minlevel] >= levelno['DEBUG']){\n            IlogLevel logObj = new DebugLevel();\n\n            logobj.log(log);\n        }\n     }\n     void logInfo(Log log){\n          if(levelno[minlevel] >= levelno['Info']){\n     }\n\n     void logWarn(Log log){\n    \n     }\n\n     void logErr(Log log){\n\n     }\n}\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nENUM Level{\n    DEBUG, 4\n    INFO,  3\n    WARN,  2\n    ERR   1\n}\n\nclass log{\n    string logId\n    Level  level\n    string message\n    Date   timestamp\n}\n\n\nclass ILogLevel{\n    \n    void log(Log log){}\n    \n}\n\nclass DebugLevel : IlogLevel{\n\n    LogRepository logrepo;\n\n    void log(Log log){\n         logrepo.savelog(log);       \n     }\n\n}\n\nclass WarnLevel : IlogLevel{\n\n    void log(Log log){\n        //log message as Warn\n    }\n\n}\n\nclass logger{\n    Level minLevel; //pull from config\n    map<Level,int> levelno\n\n     void logDebug(Log log){\n        if(levelno[minlevel] >= levelno['DEBUG']){\n            IlogLevel logObj = new DebugLevel();\n\n            logobj.log(log);\n        }\n     }\n     void logInfo(Log log){\n          if(levelno[minlevel] >= levelno['Info']){\n     }\n\n     void logWarn(Log log){\n    \n     }\n\n     void logErr(Log log){\n\n     }\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "C_ZhTllZi2HjlXhOSKzdD",
      "type": "text",
      "x": 20681.224808982053,
      "y": -985.2778054199662,
      "width": 631.3997192382812,
      "height": 1715,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 1804424379,
      "version": 775,
      "versionNonce": 423119963,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787686775552,
      "link": null,
      "locked": false,
      "text": "class LogRepository{\n    \n    List<IDest> dests; //pull from config\n    \n    queue<Log> q;\n    mutex mt;\n    \n    void push(Log log){\n        q.push(log);\n    }\n    \n    void process(){\n     while(running){\n        mt.lock();\n        Log log = q.front();\n        q.pop();\n        \n         for(auto dest: dests){\n            dest.StoreLog(log);\n       }    \n\n    }\n\n\n}\n\n\nclass IDest{\n    \n    void StoreLog(Log log){};\n\n}\n\n\nclass FileDest : IDest{\n\n    void StoreLog(Log log){\n        //store to file\n    }\n\n}\n\nclass ConsoleDest : IDest{\n\n    void StoreLog(Log log){\n        //output to console\n    }\n\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class LogRepository{\n    \n    List<IDest> dests; //pull from config\n    \n    queue<Log> q;\n    mutex mt;\n    \n    void push(Log log){\n        q.push(log);\n    }\n    \n    void process(){\n     while(running){\n        mt.lock();\n        Log log = q.front();\n        q.pop();\n        \n         for(auto dest: dests){\n            dest.StoreLog(log);\n       }    \n\n    }\n\n\n}\n\n\nclass IDest{\n    \n    void StoreLog(Log log){};\n\n}\n\n\nclass FileDest : IDest{\n\n    void StoreLog(Log log){\n        //store to file\n    }\n\n}\n\nclass ConsoleDest : IDest{\n\n    void StoreLog(Log log){\n        //output to console\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "nVA51zCZktbAnGCYdYJc4",
      "type": "text",
      "x": 23874.015893346554,
      "y": -1378.22470482089,
      "width": 985.599609375,
      "height": 1995,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1O",
