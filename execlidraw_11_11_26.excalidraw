    {
      "id": "6dWT13_x0obXqG7T9cI6X",
      "type": "text",
      "x": 20906.589741182066,
      "y": 10733.352839040994,
      "width": 902.34375,
      "height": 96,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1067211158,
      "version": 138,
      "versionNonce": 409032278,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788617070279,
      "link": null,
      "locked": false,
      "text": "- Kafka, our event log, we'll set up multiple partitions (3-5) to handle our \nthroughput needs, with partitioning by payment_intent_id to ensure ordering \nwhile allowing parallel processing. We'll configure Kafka with a replication\n factor of 3 for fault tolerance.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 91,
      "containerId": null,
      "originalText": "- Kafka, our event log, we'll set up multiple partitions (3-5) to handle our \nthroughput needs, with partitioning by payment_intent_id to ensure ordering \nwhile allowing parallel processing. We'll configure Kafka with a replication\n factor of 3 for fault tolerance.",
      "lineHeight": 1.2,
      "index": "bDX",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "IQB5UtapBZVzocpleshti",
      "type": "text",
      "x": 20908.027248724404,
      "y": 10866.79224838897,
      "width": 867.1875,
      "height": 24,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2101917398,
      "version": 119,
      "versionNonce": 475998614,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788607510890,
      "link": null,
      "locked": false,
      "text": "ordering in this ->PaymentCreated -> PaymentAuthorized -> PaymentSucceeded",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 19,
      "containerId": null,
      "originalText": "ordering in this ->PaymentCreated -> PaymentAuthorized -> PaymentSucceeded",
      "lineHeight": 1.2,
      "index": "bDY",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "HjlB1xvY0lEUG-NYJ0yxy",
      "type": "text",
      "x": 22410.254714489758,
      "y": 11100.734681943988,
      "width": 1125,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 402091030,
      "version": 139,
      "versionNonce": 1496418006,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788607510890,
      "link": null,
      "locked": false,
      "text": "To ensure transaction safety despite asynchronous payment networks, we'll implement an event\n sourcing architecture with reconciliation. Rather than just storing the current state of \nPaymentIntents and transactions, we'll record every state change as an immutable event in a \nchronological log using Kafka. This log becomes the authoritative record of everything that has \nhappened, and the current state is derived by replaying these events.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 115,
      "containerId": null,
      "originalText": "To ensure transaction safety despite asynchronous payment networks, we'll implement an event\n sourcing architecture with reconciliation. Rather than just storing the current state of \nPaymentIntents and transactions, we'll record every state change as an immutable event in a \nchronological log using Kafka. This log becomes the authoritative record of everything that has \nhappened, and the current state is derived by replaying these events.",
      "lineHeight": 1.2,
      "index": "bDZ",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "XUP4orKVhiVkJnictA-ZZ",
