      "updated": 1788171851176,
      "link": null,
      "locked": false,
      "text": "class NotificationWorker{\n    \n    NotificationSenderFactory factory\n    NotificationService service\n    \n    NotificationWorker(factory, svc){\n        factory = factory\n        service = svc\n    }\n\n\n    run(){\n\n      while(running){\n          \n           notification = service.acquireNotification()\n        \n           //check status && retrycount\n\n           sender  = factory.getnotifacationsender(notifaction.channel)\n           \n            //validate the prefrence\n           isuccess = sender.send(notifaction)\n\n           if(!issuccess){\n             notifiaction.retrycount++\n             notification.status = 'QUEUED'\n             notification.scheduleAt = nowutc() + retrystrategy.getdelay(); //fetch from approprite stratgey\n\n             service.send(notification) \n             CONTINUE\n           }\n\n           \n            notifcation.status = 'COMPLETED'\n            repo.save(notification)\n    \n\n      }\n\n    }\n\n}\n\n\n\nIRetryStrategy {\n\n    int getDelay(){}\n}\n\n\nFixDelayStrategy : IretryStrategy{\n    \n     int getDelay(notification){\n\n        //calculate next delay\n    }\n}\n\n\nExpDelayStrategy : IretryStrategy{\n    \n     int getDelay(notification){\n\n        //calculate next delay\n    }\n}\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class NotificationWorker{\n    \n    NotificationSenderFactory factory\n    NotificationService service\n    \n    NotificationWorker(factory, svc){\n        factory = factory\n        service = svc\n    }\n\n\n    run(){\n\n      while(running){\n          \n           notification = service.acquireNotification()\n        \n           //check status && retrycount\n\n           sender  = factory.getnotifacationsender(notifaction.channel)\n           \n            //validate the prefrence\n           isuccess = sender.send(notifaction)\n\n           if(!issuccess){\n             notifiaction.retrycount++\n             notification.status = 'QUEUED'\n             notification.scheduleAt = nowutc() + retrystrategy.getdelay(); //fetch from approprite stratgey\n\n             service.send(notification) \n             CONTINUE\n           }\n\n           \n            notifcation.status = 'COMPLETED'\n            repo.save(notification)\n    \n\n      }\n\n    }\n\n}\n\n\n\nIRetryStrategy {\n\n    int getDelay(){}\n}\n\n\nFixDelayStrategy : IretryStrategy{\n    \n     int getDelay(notification){\n\n        //calculate next delay\n    }\n}\n\n\nExpDelayStrategy : IretryStrategy{\n    \n     int getDelay(notification){\n\n        //calculate next delay\n    }\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
