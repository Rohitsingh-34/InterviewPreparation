    {
      "id": "6x0gmCDJvL81-YRFim1sw",
      "type": "text",
      "x": 37838.03877457999,
      "y": 20513.07082170613,
      "width": 923.9996337890625,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
