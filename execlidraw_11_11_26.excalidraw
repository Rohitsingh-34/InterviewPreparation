      "updated": 1786560066207,
      "link": null,
      "locked": false,
      "text": "ENUM Intrustuments: stocks, bonds\n\n\nENUM Instrutument{                        \n    STOCK \n    BOND\n    ETF\n    ALL\n}\n\nENUM Operator{\n    GREATER_THAN,\n    SMALLER_THAN,\n    EQUAL_TO\n    GREATER_AND_EQUAL\n}\n\nENUM RuleType{\n        PERCENTAGE,\n        AMOUNT_IN_DOLLAR,\n        AMOUNT_IN_LOCALCURRNCY   \n}\n\n\n\nClass IntrumentFee{\n    RuleEngine ruleeng;\n\n    int getIntrumentFee(InstumentType, amount){\n       return ruleeng.getInstFee(InstrumentType, amount);\n    }\n\n}\n\nClass RuleEngine{\n    Ruleexecutor RuleXxcConfig;\n    \n    List<RuleConfig> ParseConfig(){\n         \n        //get json config from zookeeeper\n\n        //parse it into the RuleConfig class\n\n        return ruleConfigs\n    }\n\n    List<RuleConfig>  filterRules(List<RuleConfig> ruleconfigs, Instrument instType){\n        List<RuleConfig> finalrules; \n\n        for(ruleconfig : ruleconfigs){\n              if(instType == ruleconfig.Intrument)\n                finalrules.push(ruleconfig)\n        }\n\n        retrun finalrules;\n    }\n\n    int getInstFee(Instrument insttype, float amount){\n         \n        ruleList = ParseConfig();\n        filterdRuleList = filterRules(ruleconfigs, instType);\n        \n        if(RuleXxcConfig.IsApplicable(amount, ruleconfig.condition)){\n                float fee += RuleExcConfig.applyRule(ruleconfig.rule);\n        }\n        \n        return fee;\n    }\n\n\n\n}\n\n\nClass RuleConfig{\n    Instrument  instrumentType\n    List<Condition> condition\n    Rate  rate\n}\n\nClass Condition{\n        string field\n        Enum operator\n        int value\n}\n\nClass Rule{\n    RuleType: PERCENTAGE,\n    int value\n\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ENUM Intrustuments: stocks, bonds\n\n\nENUM Instrutument{                        \n    STOCK \n    BOND\n    ETF\n    ALL\n}\n\nENUM Operator{\n    GREATER_THAN,\n    SMALLER_THAN,\n    EQUAL_TO\n    GREATER_AND_EQUAL\n}\n\nENUM RuleType{\n        PERCENTAGE,\n        AMOUNT_IN_DOLLAR,\n        AMOUNT_IN_LOCALCURRNCY   \n}\n\n\n\nClass IntrumentFee{\n    RuleEngine ruleeng;\n\n    int getIntrumentFee(InstumentType, amount){\n       return ruleeng.getInstFee(InstrumentType, amount);\n    }\n\n}\n\nClass RuleEngine{\n    Ruleexecutor RuleXxcConfig;\n    \n    List<RuleConfig> ParseConfig(){\n         \n        //get json config from zookeeeper\n\n        //parse it into the RuleConfig class\n\n        return ruleConfigs\n    }\n\n    List<RuleConfig>  filterRules(List<RuleConfig> ruleconfigs, Instrument instType){\n        List<RuleConfig> finalrules; \n\n        for(ruleconfig : ruleconfigs){\n              if(instType == ruleconfig.Intrument)\n                finalrules.push(ruleconfig)\n        }\n\n        retrun finalrules;\n    }\n\n    int getInstFee(Instrument insttype, float amount){\n         \n        ruleList = ParseConfig();\n        filterdRuleList = filterRules(ruleconfigs, instType);\n        \n        if(RuleXxcConfig.IsApplicable(amount, ruleconfig.condition)){\n                float fee += RuleExcConfig.applyRule(ruleconfig.rule);\n        }\n        \n        return fee;\n    }\n\n\n\n}\n\n\nClass RuleConfig{\n    Instrument  instrumentType\n    List<Condition> condition\n    Rate  rate\n}\n\nClass Condition{\n        string field\n        Enum operator\n        int value\n}\n\nClass Rule{\n    RuleType: PERCENTAGE,\n    int value\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
