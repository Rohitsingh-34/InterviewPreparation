    {
      "id": "DhHJIxRLaU5emXvn8ShiF",
      "type": "text",
      "x": -6345.332419913644,
      "y": 594.5834740251462,
      "width": 570,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6D",
      "roundness": null,
      "seed": 66489667,
      "version": 35,
      "versionNonce": 1956137187,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "STARTUP  (runs once)\n=============================\n\n1. RuleConfigRepository\n       loads JSON / DB rule configs\n            |\n2. FeeRuleLoader\n            |\n       +----+-------------------+\n       |                        |\n3. ConditionFactory     4. FeeCalculationFactory\n   \"AMOUNT\"  ->            \"PERCENTAGE\" ->\n   AmountCondition         PercentageFeeCalculation\n   \"CUSTOMER_TYPE\" ->      \"FIXED\" ->\n   CustomerTypeCondition   FixedFeeCalculation\n       |                        |\n       +----------+-------------+\n                  |\n5.          new FeeRule(scope, conditions, calculation)\n                  |\n6.          new FeeCalculator(List<FeeRule>)\n\nRules are built ONCE and reused for every request.",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STARTUP  (runs once)\n=============================\n\n1. RuleConfigRepository\n       loads JSON / DB rule configs\n            |\n2. FeeRuleLoader\n            |\n       +----+-------------------+\n       |                        |\n3. ConditionFactory     4. FeeCalculationFactory\n   \"AMOUNT\"  ->            \"PERCENTAGE\" ->\n   AmountCondition         PercentageFeeCalculation\n   \"CUSTOMER_TYPE\" ->      \"FIXED\" ->\n   CustomerTypeCondition   FixedFeeCalculation\n       |                        |\n       +----------+-------------+\n                  |\n5.          new FeeRule(scope, conditions, calculation)\n                  |\n6.          new FeeCalculator(List<FeeRule>)\n\nRules are built ONCE and reused for every request.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "hG1i90Y2f8YGQkXW0WGTo",
      "type": "rectangle",
      "x": -5700.332419913644,
      "y": 569.5834740251462,
      "width": 660,
      "height": 400,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6E",
      "roundness": {
        "type": 3
      },
