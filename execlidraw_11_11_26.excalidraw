    {
      "id": "TFJCu13ouGQB2eZDH8E6W",
      "type": "text",
      "x": 53135.521234623746,
      "y": 9919.624277886602,
      "width": 754.5997314453125,
      "height": 210,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
