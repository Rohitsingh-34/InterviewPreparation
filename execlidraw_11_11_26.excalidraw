      "containerId": null,
      "originalText": "class JobWorker{\n    JobScheduler jobscheduler\n    JobExecutor jobexcutor\n\n    JobWroker(jobscheduler, jobexecutor){\n        \n    }\n    \n    //cronjob\n\n    run(){\n        while(true){\n            \n                  job = jobscheduler.acquirejob()\n                   \n                    if(job==null)\n                        continue\n                       \n                        issuccess = jobexecutor.execute(job)\n                        \n                        if(issuccess){\n                            job.status = 'COMPLETED'\n                            jobrepo.savejob(job)\n                            continue\n                        }\n                \n                        retryconfig = jobrepo.retryconfig(jobconfig);\n    \n                        retrypolicy  = jobpolicyfactory.getretrypolocy(policynum);\n\n                        if(job.retrycount = job.maxretrycount){\n                            job.status = 'FAILED'\n                            jobrepo.savejob(job);\n                            CONTIUNE\n                        }\n                        \n                        int delay = retryPolicy.getretrydelay(Job);\n                        \n                        job.retrycount++;\n                        job.scheduldeAT = now + delay\n                        \n                        jobscheduler.submitjob(job);\n    \n                  }\n            }\n        }\n    }\n}\n\nclass JobRepository{\n    map<jobid, Job[]> jobs\n    map<jobtype, RetryConfig> retryconfig\n    \n    retryconfig getretryconfig(jobtype){\n        //return retry config for the job\n    }\n    \n    void savejob(Job job){\n        map[jobid] = job;\n    }\n    \n}\n\n\n\nclass RetryConfig{\n      jobtype\n      maxretry\n      delay\n      RetryPolicyENUM\n}\n\n\nclass retryPolicyFactory{\n\n    IRetryStrategy getRetryPolicyObj(PolicyENUM){\n            if( policy == 'fixed')\n                return new fixedTimeStrategy();\n\n            else if(policy == 'exp')\n                return new expTimeStrategy();\n    }\n\n}\n\n\nInterface IRetryStrategy{\n        \n    void getretrydelay(Job,retryconfig){}\n\n}\n\n\nfixedTimeStrategy: IRetryStrategy{\n    \n    void getretrydelay(Job, cofig){\n        //impement it\n    }\n\n}\n\nExpTimeStrategy: IRetryStrategy{\n    \n    void getretrydelay(Job, config){\n        //impement it\n    }\n\n}\n\n\n\nclass JobExecutor{\n\n    bool Execute(Job){\n        //execute job and return status\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
