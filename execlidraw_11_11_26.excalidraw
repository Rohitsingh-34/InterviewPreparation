    {
      "id": "sw4eYinZuMzu4-Dy-4YH_",
      "type": "text",
      "x": -3405.3900671747133,
      "y": -806.7887740992041,
      "width": 726,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6M",
      "roundness": null,
      "seed": 860133859,
      "version": 40,
      "versionNonce": 2113159555,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "\n{\n  \"ruleId\": \"PREMIUM_LARGE_SELL_STOCK\",\n  \"category\": \"BASE_FEE\",\n  \"priority\": 200,\n  \"instrumentTypes\": [\"STOCK\"],\n  \"conditions\": [\n    { \"type\": \"AMOUNT\",\n      \"params\": { \"operator\": \"GREATER_THAN\", \"value\": 500000 } },\n    { \"type\": \"CUSTOMER_TYPE\",\n      \"params\": { \"value\": \"PREMIUM\" } },\n    { \"type\": \"TRANSACTION_TYPE\",\n      \"params\": { \"value\": \"SELL\" } }\n  ],\n  \"calculation\": { \"type\": \"PERCENTAGE\", \"value\": 0.05 }\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n{\n  \"ruleId\": \"PREMIUM_LARGE_SELL_STOCK\",\n  \"category\": \"BASE_FEE\",\n  \"priority\": 200,\n  \"instrumentTypes\": [\"STOCK\"],\n  \"conditions\": [\n    { \"type\": \"AMOUNT\",\n      \"params\": { \"operator\": \"GREATER_THAN\", \"value\": 500000 } },\n    { \"type\": \"CUSTOMER_TYPE\",\n      \"params\": { \"value\": \"PREMIUM\" } },\n    { \"type\": \"TRANSACTION_TYPE\",\n      \"params\": { \"value\": \"SELL\" } }\n  ],\n  \"calculation\": { \"type\": \"PERCENTAGE\", \"value\": 0.05 }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "XG0W8Wa2FKnIpR6YLPpNW",
      "type": "text",
      "x": -3420.673541007688,
      "y": -182.45051104549975,
      "width": 539,
      "height": 1750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6N",
      "roundness": null,
      "seed": 402482563,
      "version": 918,
      "versionNonce": 697768227,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "Interface FeeCalculation{\n\n    int Calculate(FeeContext context);\n\n}\n\n\nClass PercentageFeeCalculation : FeeCalculation{\n    float percentage;\n\n    PercentageFeeCalculation(float perc){\n            percentage = perc;\n    }\n    \n    \n    int Calculate(FeeContext context){\n         //\n        perc = context.amount * \n        \n    }\n\n}\n\nClass FixFeeCalculation : FeeCalculation{\n    \n    int Calculate(FeeContext context){\n         //\n        perc = context.\n        \n    }\n\n}\n\n\n\nInterface Condition{\n\n    bool matches(context);\n\n}\n\n\nbool AmountCondition : Condition{\n    Operator operator\n    float value\n    \n    AmountCondition(Operator , value){\n        operator = operator\n        value = value\n    }\n    \n    bool matchs(context){\n        //compare with context->amount\n        return;    \n    }\n}\n\nbool CustomerTypeCondition: condition{\n    TransactionType value\n\n    CustomerTypeCondition(TransactionType value){\n        value=value\n    }\n    \n    bool matchs(context){\n        //compare with context->transactiontype\n        return;    \n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interface FeeCalculation{\n\n    int Calculate(FeeContext context);\n\n}\n\n\nClass PercentageFeeCalculation : FeeCalculation{\n    float percentage;\n\n    PercentageFeeCalculation(float perc){\n            percentage = perc;\n    }\n    \n    \n    int Calculate(FeeContext context){\n         //\n        perc = context.amount * \n        \n    }\n\n}\n\nClass FixFeeCalculation : FeeCalculation{\n    \n    int Calculate(FeeContext context){\n         //\n        perc = context.\n        \n    }\n\n}\n\n\n\nInterface Condition{\n\n    bool matches(context);\n\n}\n\n\nbool AmountCondition : Condition{\n    Operator operator\n    float value\n    \n    AmountCondition(Operator , value){\n        operator = operator\n        value = value\n    }\n    \n    bool matchs(context){\n        //compare with context->amount\n        return;    \n    }\n}\n\nbool CustomerTypeCondition: condition{\n    TransactionType value\n\n    CustomerTypeCondition(TransactionType value){\n        value=value\n    }\n    \n    bool matchs(context){\n        //compare with context->transactiontype\n        return;    \n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
