      "updated": 1788033086471,
      "link": null,
      "locked": false,
      "text": "TicketHandler\n-map<ticketid,Ticket> tickets\n-IParkingFeeStrategy feestrgy;\n-IPaymentStrategy paymentstrgy\n\n\nTicket generateTicket(vehicle,spot){\n    ticket = Ticket(vechile,spot);\n    tickets[vechicleNumber] = ticket\n    return ticket\n}\n\nTicket ExistRequest(tickeid){\n    ticket = tickets[ticketid]\n    amount = feestrgy.calculatefee(ticket)\n\n    issuccess = paymentstrgy.pay(amount)\n    if(success)\n        ticket//update exist time and amount\n    return Ticket\n}\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TicketHandler\n-map<ticketid,Ticket> tickets\n-IParkingFeeStrategy feestrgy;\n-IPaymentStrategy paymentstrgy\n\n\nTicket generateTicket(vehicle,spot){\n    ticket = Ticket(vechile,spot);\n    tickets[vechicleNumber] = ticket\n    return ticket\n}\n\nTicket ExistRequest(tickeid){\n    ticket = tickets[ticketid]\n    amount = feestrgy.calculatefee(ticket)\n\n    issuccess = paymentstrgy.pay(amount)\n    if(success)\n        ticket//update exist time and amount\n    return Ticket\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
