      "updated": 1787005934966,
      "link": null,
      "locked": false,
      "text": "Notification System : \n\n\nRequirements:\n1. Send notifications through email, SMS & push\n2. support user prefrences (opt-in/out for certain types)\n3. Handle failures with retries\n4. support scheduled(future-dated) notifcations\n\n\n\n\nClass Notifaction{\n    int NotifacationId,\n    User user\n    NotificationType N-type\n    Category category\n    Message message\n    Object Param \n    ScheduleTime    \n}\n\n\nclass NotifcationSystem{\n   NotifyScheduler notifyscheduler;\n   \n    void sendNow(Notifcation notification, User user){\n\n        notifyscheduler.scheduleNow(Notifcation notification, User user);\n        \n    }\n\n    void ScheduleSend(Notifcation notification, User user, Date Time){\n\n        notifyscheduler.scheduleForTime(Notifcation notification, User user, datetime time);\n\n    }\n\n\n}\n\nclass NotifyScheduler{\n    \n    map<timeRange,List<Notication,user>>  timeToUser\n\n    NotifYService notifysevice;\n\n    BlockingQueue<Notification> blockingqueue(min heap);\n\n    void sendNow(Notifcation notification, User user){\n\n        notifyservice.notify(notification, user);\n    }\n\n    void scheduleForTime(Notifcation notification, User user, Date Time){\n         \n        // udpate timeToUser table/map\n     \n    }\n\n\n    process() {\n        \n        // pick from timeToUser map based on current time\n        //process them based on the time\n        \n          notifyservice.notify(notification, user);\n\n    }\n    \n\n}\n\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notification System : \n\n\nRequirements:\n1. Send notifications through email, SMS & push\n2. support user prefrences (opt-in/out for certain types)\n3. Handle failures with retries\n4. support scheduled(future-dated) notifcations\n\n\n\n\nClass Notifaction{\n    int NotifacationId,\n    User user\n    NotificationType N-type\n    Category category\n    Message message\n    Object Param \n    ScheduleTime    \n}\n\n\nclass NotifcationSystem{\n   NotifyScheduler notifyscheduler;\n   \n    void sendNow(Notifcation notification, User user){\n\n        notifyscheduler.scheduleNow(Notifcation notification, User user);\n        \n    }\n\n    void ScheduleSend(Notifcation notification, User user, Date Time){\n\n        notifyscheduler.scheduleForTime(Notifcation notification, User user, datetime time);\n\n    }\n\n\n}\n\nclass NotifyScheduler{\n    \n    map<timeRange,List<Notication,user>>  timeToUser\n\n    NotifYService notifysevice;\n\n    BlockingQueue<Notification> blockingqueue(min heap);\n\n    void sendNow(Notifcation notification, User user){\n\n        notifyservice.notify(notification, user);\n    }\n\n    void scheduleForTime(Notifcation notification, User user, Date Time){\n         \n        // udpate timeToUser table/map\n     \n    }\n\n\n    process() {\n        \n        // pick from timeToUser map based on current time\n        //process them based on the time\n        \n          notifyservice.notify(notification, user);\n\n    }\n    \n\n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
