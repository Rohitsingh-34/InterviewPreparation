      "seed": 785694166,
      "version": 104,
      "versionNonce": 88444374,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788607510890,
      "link": null,
      "locked": false,
      "text": "How would you ensure secure authentication for merchants using the payment system?",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 19,
      "containerId": null,
      "originalText": "How would you ensure secure authentication for merchants using the payment system?",
      "lineHeight": 1.2,
      "index": "bDE",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "SuWhZTLTPyWaL6L-M7VNX",
      "type": "text",
      "x": 20815.48856724745,
      "y": 11171.726911086022,
      "width": 1453.125,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1751814934,
      "version": 96,
      "versionNonce": 1480680214,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788607510890,
      "link": null,
      "locked": false,
      "text": "We use HTTPS/TLS to encrypt card data in transit. Ideally, the card details go directly to a PCI-compliant payment provider,\n which tokenizes the card and returns a token. We store and use the token instead of storing the actual card number",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 43,
      "containerId": null,
      "originalText": "We use HTTPS/TLS to encrypt card data in transit. Ideally, the card details go directly to a PCI-compliant payment provider,\n which tokenizes the card and returns a token. We store and use the token instead of storing the actual card number",
      "lineHeight": 1.2,
      "index": "bDF",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "ckIVOm2rj2zt-Mldr0Nx_",
      "type": "text",
      "x": 20835.255700843903,
      "y": 11275.334257407821,
      "width": 1125,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 856932438,
      "version": 141,
      "versionNonce": 529567830,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788607510890,
      "link": null,
      "locked": false,
      "text": "The stronger design adds client side encryption on top of HTTPS so the data stays protected even\n if the merchant application path is compromised before it reaches the payment provider.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 43,
      "containerId": null,
      "originalText": "The stronger design adds client side encryption on top of HTTPS so the data stays protected even\n if the merchant application path is compromised before it reaches the payment provider.",
      "lineHeight": 1.2,
      "index": "bDG",
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
