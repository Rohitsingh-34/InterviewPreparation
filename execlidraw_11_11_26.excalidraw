    {
      "id": "KNHkptFdskvUMeo9ZKe8u",
      "type": "text",
      "x": 27589.30866872757,
      "y": 10947.206953633813,
      "width": 1183.59375,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
