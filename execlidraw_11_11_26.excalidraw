      "text": "class AudioBuffer{\n    Data data\n    int size\n    string channel\n}\n\n\nInterface IStage{    \n    void start();\n    void stop();    \n}\n\nclass Stage: IStage{\n    BoundedQueue inputqueue\n    BoundedQueue Outputqueue\n    bool running;\n    thread workerThread;\n\n    stage(input,output){\n        running = true;\n        inputqueue = input;\n        outputqueue = output;\n    }\n\n    runloop(){\n       while(ruuning){\n            AudioBuffer buff =  inputqueue.front();\n            inputput.pop();\n    \n            process(buff); //9ms ---> make it parallel\n                            with 3 threads then its 3ms \n    \n            outputqeueue.push(buff);\n        }\n        \n    }\n\npublic:\n    start(){\n        running = true;\n        workerThread = thread(&Stage::runLoop, this);\n         //start new thread for runloop\n    }\n\n    stop(){\n        running = false;\n        if(workerThread.joinable()) workerThread.join(); \n        //close the current thread;\n    }\n\n    virtual void Process(AudioBuffer* audbuff){}\n    \n}\n\nclass NoiseFilterStage : Stage{\n    \n     NoiseFilterStage(inputqueue, outputque) : stage(input,output){}\n    \n    @override\n    void Process(AudioBuffer* audbuff){\n        //filter the audbuff\n    }\n    \n}\n\nclass formatConvertStage : Stage{\n    \n    @override\n    void Process(AudioBuffer audbuff){\n        //filter the audbuff\n    }\n    \n}\n\n\n\nclass AudioPipline{\n\n     vector<IStage*> stages;\n\n    AudioPipeline(){}\n\n    void addstages(IStage*  stage){\n        stages.push(stage);  \n    }\n\n    void start(){\n        for(auto stage: stages){\n           stage.start();\n        }\n    }\n    \n    void stop(){\n        for(auto stage: stages){\n           stage.stop();\n        }\n    }\n\n}\n\n\nclass orchestrator{\n\n    AudioPipeline* audPipeline\n\n    BoundedQueue* q0  =  new BoundedQueue(10);\n    BoundedQueue* q1  =  new BoundedQueue(10);\n    BoundedQueue* q2  =  new BoundedQueue(10);\n    BoundedQueue* q3  =  new BoundedQueue(10);\n\n    audPipeline->addstge(new NoiseFilterStage(q0,q1));\n    audPipeline->addstge(new GainStage(q1,q2));\n    audPipeline->addstge(new GainStage(q2,q3));\n\n    audPipeline.start();\n\n}\n\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class AudioBuffer{\n    Data data\n    int size\n    string channel\n}\n\n\nInterface IStage{    \n    void start();\n    void stop();    \n}\n\nclass Stage: IStage{\n    BoundedQueue inputqueue\n    BoundedQueue Outputqueue\n    bool running;\n    thread workerThread;\n\n    stage(input,output){\n        running = true;\n        inputqueue = input;\n        outputqueue = output;\n    }\n\n    runloop(){\n       while(ruuning){\n            AudioBuffer buff =  inputqueue.front();\n            inputput.pop();\n    \n            process(buff); //9ms ---> make it parallel\n                            with 3 threads then its 3ms \n    \n            outputqeueue.push(buff);\n        }\n        \n    }\n\npublic:\n    start(){\n        running = true;\n        workerThread = thread(&Stage::runLoop, this);\n         //start new thread for runloop\n    }\n\n    stop(){\n        running = false;\n        if(workerThread.joinable()) workerThread.join(); \n        //close the current thread;\n    }\n\n    virtual void Process(AudioBuffer* audbuff){}\n    \n}\n\nclass NoiseFilterStage : Stage{\n    \n     NoiseFilterStage(inputqueue, outputque) : stage(input,output){}\n    \n    @override\n    void Process(AudioBuffer* audbuff){\n        //filter the audbuff\n    }\n    \n}\n\nclass formatConvertStage : Stage{\n    \n    @override\n    void Process(AudioBuffer audbuff){\n        //filter the audbuff\n    }\n    \n}\n\n\n\nclass AudioPipline{\n\n     vector<IStage*> stages;\n\n    AudioPipeline(){}\n\n    void addstages(IStage*  stage){\n        stages.push(stage);  \n    }\n\n    void start(){\n        for(auto stage: stages){\n           stage.start();\n        }\n    }\n    \n    void stop(){\n        for(auto stage: stages){\n           stage.stop();\n        }\n    }\n\n}\n\n\nclass orchestrator{\n\n    AudioPipeline* audPipeline\n\n    BoundedQueue* q0  =  new BoundedQueue(10);\n    BoundedQueue* q1  =  new BoundedQueue(10);\n    BoundedQueue* q2  =  new BoundedQueue(10);\n    BoundedQueue* q3  =  new BoundedQueue(10);\n\n    audPipeline->addstge(new NoiseFilterStage(q0,q1));\n    audPipeline->addstge(new GainStage(q1,q2));\n    audPipeline->addstge(new GainStage(q2,q3));\n\n    audPipeline.start();\n\n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "LQoPjqh70dAeq6A1Np2Dx",
      "type": "text",
      "x": 9100.473028580502,
