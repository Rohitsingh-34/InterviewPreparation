      "updated": 1788034274991,
      "link": null,
      "locked": false,
      "text": "Spot\n\n-spotId\n-spotType\n-levelid\n-status\n-expirytime\n-MUTEX mt\n\nBool TryOccupy(vtype){\n    mt.lock()\n    if(vtype == spottype\n        && status == 'AVAIBLE')\n        status = 'HELD'\n        return spot\n}\n\nbool updateStatus(status){\n    status = status\n}",
      "fontSize": 25.809755698531696,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spot\n\n-spotId\n-spotType\n-levelid\n-status\n-expirytime\n-MUTEX mt\n\nBool TryOccupy(vtype){\n    mt.lock()\n    if(vtype == spottype\n        && status == 'AVAIBLE')\n        status = 'HELD'\n        return spot\n}\n\nbool updateStatus(status){\n    status = status\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
