    {
      "id": "9IssVA7fGEsFKsL4ZkmgB",
      "type": "text",
      "x": 28866.813572460956,
      "y": 9400.876848965363,
      "width": 304.6875,
      "height": 48,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
