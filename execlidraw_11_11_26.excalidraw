      "seed": 752098669,
      "version": 3,
      "versionNonce": 5465645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786464649667,
      "link": null,
      "locked": false,
      "text": "Request\n  → validate playlist size and proportion\n  → fetch extra candidates from both services\n  → apply user filters\n  → deduplicate by song ID\n  → calculate source quotas\n  → select tracks\n  → fill shortages if allowed\n  → interleave tracks\n  → return playlist",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Request\n  → validate playlist size and proportion\n  → fetch extra candidates from both services\n  → apply user filters\n  → deduplicate by song ID\n  → calculate source quotas\n  → select tracks\n  → fill shortages if allowed\n  → interleave tracks\n  → return playlist",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
