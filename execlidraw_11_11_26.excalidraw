    {
      "id": "yid-EwWTHYnWuEH2rcSGD",
      "type": "text",
      "x": 31163.926077577373,
      "y": 9091.186369005663,
      "width": 1540,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFe",
      "roundness": null,
      "seed": 391748042,
      "version": 4,
      "versionNonce": 860927498,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788673170577,
      "link": null,
      "locked": false,
      "text": "Ticketmaster is an online platform that allows users to purchase tickets for concerts, sports events, theater, and other live entertainment.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ticketmaster is an online platform that allows users to purchase tickets for concerts, sports events, theater, and other live entertainment.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "jV4J0PJG531X4Z--J-vZu",
      "type": "text",
      "x": 31163.90991214159,
      "y": 8997.893198474889,
      "width": 395.999755859375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFf",
      "roundness": null,
      "seed": 1260185430,
      "version": 53,
      "versionNonce": 1555009546,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788673194488,
      "link": null,
      "locked": false,
      "text": "Design TicketMaster:",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design TicketMaster:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "KA0YjU0Xcq1WiTYHvxpuL",
      "type": "text",
      "x": 31179.11335095936,
      "y": 9198.079041378438,
      "width": 1324.399658203125,
      "height": 490,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFg",
      "roundness": null,
      "seed": 1958428374,
      "version": 728,
      "versionNonce": 1251462998,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788673538379,
      "link": null,
      "locked": false,
      "text": "Functional Requirement:\n\n- user should able to search the events\n- user should able to see details of event and select the seats and reserved the seats\n- user should able to pay and get tocket for booked seats\n\n\n\nnon-funcational requirement:\n\n- high aviablitity (in search ) && strong consistency in (booking)\n- search latency should be < 100ms\n- scale should 100M DAU -> 100:1 on booking -> 1M DAU for booking\n- system should not allow double booking of a seat(concurrency)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement:\n\n- user should able to search the events\n- user should able to see details of event and select the seats and reserved the seats\n- user should able to pay and get tocket for booked seats\n\n\n\nnon-funcational requirement:\n\n- high aviablitity (in search ) && strong consistency in (booking)\n- search latency should be < 100ms\n- scale should 100M DAU -> 100:1 on booking -> 1M DAU for booking\n- system should not allow double booking of a seat(concurrency)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "uzdI0reXwk3PlskkEL93T",
      "type": "text",
      "x": 31171.237019859404,
      "y": 9775.676655375199,
      "width": 184.7999267578125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFh",
      "roundness": null,
      "seed": 559925014,
      "version": 128,
      "versionNonce": 516685834,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788678037219,
      "link": null,
      "locked": false,
      "text": "Core Entity:\n\n- Bookings\n- User\n- Events\n- Tickets\n- Venue\n- performer\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entity:\n\n- Bookings\n- User\n- Events\n- Tickets\n- Venue\n- performer\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "E8Q82iZ3PzKrqGv7rbbgd",
      "type": "text",
      "x": 31160.489994442938,
      "y": 10204.004845684554,
      "width": 1031.7996826171875,
      "height": 665,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFj",
      "roundness": null,
      "seed": 1631932362,
      "version": 674,
      "versionNonce": 1019269206,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "_4uXtRSWuwQrHLolFw2ZS",
          "type": "arrow"
        }
      ],
      "updated": 1788678649207,
      "link": null,
      "locked": false,
      "text": "  API:\n  \n  GET  /Search?keyword={}&location={} -> partialevent[]\n\n  GET /events/{eventid}/getdetails  -> Event && location & Ticket[]\n   \n  POST bookings/reserve  -> bookingId\n  header : JWT-Token\n  body:\n  {\n        ticketId\n  }\n\n  POST bookings/confirm  -> bookingstatus\n  header : JWT-Token\n  {\n      ticketid\n      paymentdetails(stripe/razorepay)\n  } ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  API:\n  \n  GET  /Search?keyword={}&location={} -> partialevent[]\n\n  GET /events/{eventid}/getdetails  -> Event && location & Ticket[]\n   \n  POST bookings/reserve  -> bookingId\n  header : JWT-Token\n  body:\n  {\n        ticketId\n  }\n\n  POST bookings/confirm  -> bookingstatus\n  header : JWT-Token\n  {\n      ticketid\n      paymentdetails(stripe/razorepay)\n  } ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
