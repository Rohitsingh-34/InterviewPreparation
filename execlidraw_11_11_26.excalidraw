      "locked": false,
      "created": null
    },
    {
      "id": "F4FDcc2_FmYTQMruhnrGJ",
      "type": "text",
      "x": -5716.494644741952,
      "y": 1634.6209195217693,
      "width": 534.375,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6X",
      "roundness": null,
      "seed": 1365175747,
      "version": 56,
      "versionNonce": 1020959075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788003632479,
      "link": null,
      "locked": false,
      "text": "REUSABLE LESSONS (any LLD)\n=================================================\n1. Rules are DATA, not classes.\n     50 rules -> 150 objects, 4 classes\n\n2. Split \"does it apply?\" from \"what does it do?\"\n     Condition  vs  Calculation\n     SongFilter vs  MixingStrategy\n\n3. Constructor = fixed config\n   Method      = varying request data\n\n4. Bundle request data into a Context object\n     matches(context)  not  matches(a, b, c, d)\n\n5. Composite gives OR / NOT without a rule engine\n\n6. Interface only for a REAL variation point\n     different algorithm -> interface\n     different value     -> just config\n\n7. Return a BREAKDOWN, not a bare number\n\n8. Registry (Map) beats switch in factories\n\n9. Validate config at STARTUP, fail fast\n\n10. Order checks cheapest-first (scope before conditions)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "REUSABLE LESSONS (any LLD)\n=================================================\n1. Rules are DATA, not classes.\n     50 rules -> 150 objects, 4 classes\n\n2. Split \"does it apply?\" from \"what does it do?\"\n     Condition  vs  Calculation\n     SongFilter vs  MixingStrategy\n\n3. Constructor = fixed config\n   Method      = varying request data\n\n4. Bundle request data into a Context object\n     matches(context)  not  matches(a, b, c, d)\n\n5. Composite gives OR / NOT without a rule engine\n\n6. Interface only for a REAL variation point\n     different algorithm -> interface\n     different value     -> just config\n\n7. Return a BREAKDOWN, not a bare number\n\n8. Registry (Map) beats switch in factories\n\n9. Validate config at STARTUP, fail fast\n\n10. Order checks cheapest-first (scope before conditions)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "MgVIu7I00QZh6g1PppxLP",
      "type": "rectangle",
      "x": -6452.638949593918,
      "y": 2290.76972943744,
      "width": 1370,
      "height": 319.4531824834388,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6Y",
